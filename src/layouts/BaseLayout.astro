---
import '../styles/global.css';
const { title = 'The Naxal Archive', description = 'A sourced, data-led archive tracking the history, geography, violence and development context of Left Wing Extremism in India.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
