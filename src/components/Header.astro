---
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const url = (path = '') =>
  `${BASE}/${path.replace(/^\/+/, '')}`;

---

<div class="language-bar" aria-label="Website language">
  <div class="shell language-bar-inner">
    <span class="language-label">Language</span>

    <div class="language-options" role="group" aria-label="Translate website">
      <button type="button" class="language-option is-active" data-site-language="en">English</button>
      <button type="button" class="language-option" data-site-language="hi">हिन्दी</button>
      <button type="button" class="language-option" data-site-language="te">తెలుగు</button>
    </div>

    <div id="google_translate_element" aria-hidden="true"></div>
  </div>
</div>

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={url()}>
      <span class="brand-name">The Naxal Archive</span>
      <span class="brand-sub">Research · Data · Documentation</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      <a href={url()}>Home</a>

      <!-- BACKGROUND DROPDOWN -->
      <div class="nav-dropdown">
        <a class="nav-dropdown-trigger" href={url('background/')}>
          Background
        </a>

        <div class="dropdown-menu background-menu">
          <div class="dropdown-label">BACKGROUND</div>

          <a href={url('background/history/')}>
            <span>
              <strong>History</strong>
              <small>The movement from Naxalbari to its later contraction</small>
            </span>
          </a>

          <a href={url('background/ideology/')}>
            <span>
              <strong>Ideology</strong>
              <small>Doctrine, political programme and revolutionary strategy</small>
            </span>
          </a>

          <a href={url('background/organisation/')}>
            <span>
              <strong>Organisation & Structure</strong>
              <small>Leadership, membership, discipline and armed structures</small>
            </span>
          </a>

          <a href={url('background/major-incidents/')}>
            <span>
              <strong>Major Incidents</strong>
              <small>Significant attacks, operations and turning points</small>
            </span>
          </a>

          <div class="dropdown-footer">
            <a href={url('background/')}>Explore all background</a>
          </div>
        </div>
      </div>

      <!-- DATA & VISUALS DROPDOWN -->
      <div class="nav-dropdown">
        <a class="nav-dropdown-trigger" href={url('data-visuals/')}>
          Data & Visuals
        </a>

        <div class="dropdown-menu data-menu">
          <div class="dropdown-label">DATA & VISUALS</div>

          <a href={url('data-visuals/senior-leadership-exits/')}>
            <span>
              <strong>Senior CPI (Maoist) Leadership Attrition & Surrenders</strong>
              <small>Searchable PBM and CCM leadership records</small>
            </span>
          </a>

          <a href={url('data-visuals/infrastructure-targeting/')}>
            <span>
              <strong>Infrastructure Targeting</strong>
              <small>Roads, telecom, rail and other infrastructure</small>
            </span>
          </a>

          <a href={url('data-visuals/lwe-surrenders/')}>
            <span>
              <strong>LWE Surrenders Since 2004</strong>
              <small>Year-wise and state-wise surrender records</small>
            </span>
          </a>

          <a href={url('data-visuals/security-force-camps/')}>
            <span>
              <strong>Security Force Camps Since 2013</strong>
              <small>Year-wise and state-wise establishment of SF camps</small>
            </span>
          </a>

          <a href={url('data-visuals/lwe-fatalities-since-1980/')}>
            <span>
              <strong>Fatalities in LWE Incidents Since 1980</strong>
              <small>Year-wise civilian, security-force and extremist deaths</small>
            </span>
          </a>

          <div class="dropdown-footer">
            <a href={url('data-visuals/')}>Explore all data</a>
          </div>
        </div>
      </div>

      <a href={url('articles/')}>Articles</a>
      <a href={url('#development')}>Tracking Development</a>
    </nav>
  </div>
</header>

<script>
  type TranslateWindow = Window & {
    google?: {
      translate?: {
        TranslateElement?: new (
          options: Record<string, unknown>,
          elementId: string
        ) => unknown;
      };
    };
    googleTranslateElementInit?: () => void;
  };

  const translateWindow = window as TranslateWindow;
  const translationCookie = document.cookie
    .split('; ')
    .find((item) => item.startsWith('googtrans='))
    ?.split('=')[1];
  const currentLanguage = translationCookie?.split('/').pop() || 'en';
  const languageButtons = document.querySelectorAll('[data-site-language]');

  const markLanguage = (language: string) => {
    languageButtons.forEach((button) => {
      button.classList.toggle(
        'is-active',
        button.getAttribute('data-site-language') === language
      );
    });
  };

  markLanguage(currentLanguage);

  const selectTranslatedLanguage = (language: string, attempts = 0) => {
    const select = document.querySelector('.goog-te-combo');

    if (select instanceof HTMLSelectElement) {
      select.value = language;
      select.dispatchEvent(new Event('change'));
      markLanguage(language);
      return;
    }

    if (attempts < 20) {
      window.setTimeout(() => selectTranslatedLanguage(language, attempts + 1), 150);
    }
  };

  const returnToEnglish = () => {
    document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    window.location.reload();
  };

  languageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const language = button.getAttribute('data-site-language');
      if (!language) return;

      if (language === 'en') returnToEnglish();
      else selectTranslatedLanguage(language);
    });
  });

  translateWindow.googleTranslateElementInit = () => {
    const TranslateElement = translateWindow.google?.translate?.TranslateElement;
    if (!TranslateElement) return;

    new TranslateElement(
      {
        pageLanguage: 'en',
        includedLanguages: 'hi,te',
        autoDisplay: false,
      },
      'google_translate_element'
    );
  };

  if (!document.querySelector('script[data-site-translator]')) {
    const translationScript = document.createElement('script');
    translationScript.src =
      'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
    translationScript.async = true;
    translationScript.dataset.siteTranslator = 'true';
    document.head.appendChild(translationScript);
  }

  const mobileMenu = window.matchMedia('(max-width: 900px)');
  const dropdowns = document.querySelectorAll('.nav-dropdown');

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector('.nav-dropdown-trigger');
    if (!(trigger instanceof HTMLAnchorElement)) return;

    trigger.setAttribute('aria-expanded', 'false');

    trigger.addEventListener('click', (event) => {
      if (!mobileMenu.matches) return;

      event.preventDefault();
      const willOpen = !dropdown.classList.contains('is-open');

      dropdowns.forEach((item) => {
        item.classList.remove('is-open');
        item.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      });

      if (willOpen) {
        dropdown.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (event) => {
    if (!mobileMenu.matches || !(event.target instanceof Node)) return;
    if ([...dropdowns].some((dropdown) => dropdown.contains(event.target))) return;

    dropdowns.forEach((dropdown) => {
      dropdown.classList.remove('is-open');
      dropdown.querySelector('.nav-dropdown-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .language-bar {
    position: relative;
    z-index: 1001;
    background: #eee8dc;
    border-bottom: 1px solid #d8d0c3;
  }

  .language-bar-inner {
    min-height: 38px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }

  .language-label {
    font-family: system-ui, sans-serif;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8a8175;
  }

  .language-options {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .language-option {
    position: relative;
    padding: 11px 0 10px;
    border: 0;
    background: transparent;
    color: #403c37;
    font-family: system-ui, sans-serif;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
  }

  .language-option::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: transparent;
  }

  .language-option:hover,
  .language-option.is-active {
    color: #111b20;
  }

  .language-option.is-active::after {
    background: #9c4f37;
  }

  #google_translate_element,
  .goog-te-banner-frame,
  .goog-te-gadget {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  .site-header {
    position: relative;
    z-index: 1000;
    background: #f7f3ea;
    border-bottom: 1px solid #d8d0c3;
  }

  .header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    color: #111b20;
    text-decoration: none;
  }

  .brand-name {
    font-family: Georgia, serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }

  .brand-sub {
    margin-top: 6px;
    font-family: system-ui, sans-serif;
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: #8a8175;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .main-nav > a,
  .nav-dropdown-trigger {
    color: #111b20;
    text-decoration: none;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    font-weight: 650;
    white-space: nowrap;
    transition: opacity .2s ease;
  }

  .main-nav > a:hover,
  .nav-dropdown-trigger:hover {
    opacity: .6;
  }

  .nav-dropdown {
    position: relative;
    padding: 30px 0;
    margin: -30px 0;
  }

  .nav-dropdown-trigger {
    display: block;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% - 2px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 440px;
    padding: 12px;
    border: 1px solid #d6cec1;
    background: #fffdf8;
    box-shadow: 0 18px 45px rgba(20, 25, 28, .12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  }

  .background-menu {
    width: 390px;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-label {
    padding: 9px 12px 12px;
    font-family: system-ui, sans-serif;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .14em;
    color: #9c4f37;
  }

  .dropdown-menu > a {
    display: block;
    padding: 14px 12px;
    border-top: 1px solid #ece5da;
    color: #111b20;
    text-decoration: none;
  }

  .dropdown-menu > a:hover,
  .dropdown-menu > a:focus-visible {
    background: #f4efe6;
    outline: none;
  }

  .dropdown-menu strong {
    display: block;
    font-family: Georgia, serif;
    font-size: 15px;
    line-height: 1.3;
  }

  .dropdown-menu small {
    display: block;
    margin-top: 5px;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    line-height: 1.4;
    color: #746d64;
  }

  .dropdown-footer {
    margin-top: 3px;
    padding: 12px;
    border-top: 1px solid #d9d1c5;
  }

  .dropdown-footer a {
    color: #111b20;
    text-decoration: none;
    font-family: system-ui, sans-serif;
    font-size: 11px;
    font-weight: 750;
  }

  .dropdown-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .language-bar-inner {
      min-height: 44px;
      justify-content: flex-start;
      overflow-x: auto;
      gap: 12px;
    }

    .language-label {
      display: none;
    }

    .language-options {
      min-width: max-content;
      gap: 19px;
    }

    .language-option {
      min-height: 44px;
      padding-top: 12px;
      padding-bottom: 11px;
      font-size: 13px;
    }

    .header-inner {
      min-height: auto;
      padding-top: 18px;
      padding-bottom: 16px;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }

    .brand-name {
      font-size: 25px;
    }

    .main-nav {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 22px;
      align-items: center;
    }

    .main-nav > a,
    .nav-dropdown-trigger {
      font-size: 14px;
    }

    .nav-dropdown {
      position: relative;
      padding: 0;
      margin: 0;
    }

    .dropdown-menu {
      display: none !important;
    }

    .nav-dropdown.is-open {
      width: 100%;
    }

    .nav-dropdown.is-open .dropdown-menu {
      position: static;
      display: block !important;
      width: 100%;
      margin-top: 12px;
      padding: 10px;
      transform: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      box-shadow: none;
    }

    .nav-dropdown.is-open .nav-dropdown-trigger {
      color: #9c4f37;
    }

  }
</style>
