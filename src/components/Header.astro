---
const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const url = (path = '') =>
  `${BASE}/${path.replace(/^\/+/, '')}`;
---

<header class="site-header">
  <div class="shell header-inner">

    <a class="brand" href={url()}>
      <span class="brand-name">The Naxal Archive</span>
      <span class="brand-sub">Research · Data · Documentation</span>
    </a>

    <nav class="main-nav" aria-label="Main navigation">

      <a href={url()}>Home</a>

    <a href={url('background/')}>Background</a>

      <!-- DATA & VISUALS DROPDOWN -->
      <div class="nav-dropdown">
        <a
          class="nav-dropdown-trigger"
          href={url('data-visuals/')}
        >
          Data & Visuals
          <span class="chevron">⌄</span>
        </a>

        <div class="dropdown-menu">

          <div class="dropdown-label">
            DATA & VISUALS
          </div>

          <a href={url('data-visuals/senior-leadership-exits/')}>
            <span class="dropdown-number">01</span>

            <span>
              <strong>
                Senior CPI (Maoist) Leadership Attrition & Surrenders
              </strong>

              <small>
                Searchable PBM and CCM leadership records
              </small>
            </span>
          </a>

          <!-- NEXT DATASET -->
<a href={url('data-visuals/infrastructure-targeting/')}>
            <span class="dropdown-number">02</span>

            <span>
              <strong>
                Infrastructure Targeting
              </strong>

              <small>
                Roads, telecom, rail and other infrastructure
    </small>
  </span>
</a>

<a href={url('data-visuals/lwe-surrenders/')}>
  <span class="dropdown-number">03</span>

  <span>
    <strong>LWE Surrenders Since 2004</strong>
    <small>
      Year-wise and state-wise surrender records
    </small>
  </span>
</a>

<a href={url('data-visuals/security-force-camps/')}>
  <span class="dropdown-number">04</span>

  <span>
    <strong>Security Force Camps Since 2013</strong>
    <small>
      Year-wise and state-wise establishment of SF camps
    </small>
  </span>
</a>




          <div class="dropdown-footer">
            <a href={url('data-visuals/')}>
              Explore all data →
            </a>
          </div>

        </div>
      </div>

      <a href={url('articles/')}>Articles</a>

      <a href={url('#development')}>
        Tracking Development
      </a>

    </nav>

  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 1000;
    background: #f7f3ea;
    border-bottom: 1px solid #d8d0c3;
  }

  .header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #111b20;
    flex-shrink: 0;
  }

  .brand-name {
    font-family: Georgia, serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }

  .brand-sub {
    margin-top: 6px;
    font-family: system-ui, sans-serif;
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .14em;
    color: #8a8175;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .main-nav > a,
  .nav-dropdown-trigger {
    color: #111b20;
    text-decoration: none;
    font-family: system-ui, sans-serif;
    font-size: 13px;
    font-weight: 650;
    white-space: nowrap;
    transition: opacity .2s ease;
  }

  .main-nav > a:hover,
  .nav-dropdown-trigger:hover {
    opacity: .6;
  }

  /* DROPDOWN */

  .nav-dropdown {
    position: relative;
    padding: 30px 0;
    margin: -30px 0;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .chevron {
    font-size: 13px;
    transition: transform .2s ease;
  }

  .nav-dropdown:hover .chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% - 2px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);

    width: 440px;

    background: #fffdf8;
    border: 1px solid #d6cec1;

    box-shadow:
      0 18px 45px rgba(20, 25, 28, .12);

    padding: 12px;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity .18s ease,
      transform .18s ease,
      visibility .18s ease;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-label {
    padding: 9px 12px 12px;

    font-family: system-ui, sans-serif;
    font-size: 9px;
    font-weight: 800;

    letter-spacing: .14em;
    color: #9c4f37;
  }

  .dropdown-menu > a {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;

    padding: 14px 12px;

    color: #111b20;
    text-decoration: none;

    border-top: 1px solid #ece5da;
  }

  .dropdown-menu > a:hover {
    background: #f4efe6;
  }

  .dropdown-number {
    padding-top: 2px;

    font-family: system-ui, sans-serif;
    font-size: 10px;
    font-weight: 800;

    color: #a05b43;
  }

  .dropdown-menu strong {
    display: block;

    font-family: Georgia, serif;
    font-size: 15px;
    line-height: 1.3;
  }

  .dropdown-menu small {
    display: block;
    margin-top: 5px;

    font-family: system-ui, sans-serif;
    font-size: 11px;
    line-height: 1.4;

    color: #746d64;
  }

  .dropdown-footer {
    border-top: 1px solid #d9d1c5;
    margin-top: 3px;
    padding: 12px;
  }

  .dropdown-footer a {
    color: #111b20;
    text-decoration: none;

    font-family: system-ui, sans-serif;
    font-size: 11px;
    font-weight: 750;
  }

  .dropdown-footer a:hover {
    text-decoration: underline;
  }

  /* MOBILE */

  @media (max-width: 900px) {
  .header-inner {
    min-height: auto;
    padding-top: 18px;
    padding-bottom: 16px;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .brand-name {
    font-size: 25px;
  }

  .brand-sub {
    font-size: 8px;
  }

  .main-nav {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    align-items: center;
  }

  .main-nav > a,
  .nav-dropdown-trigger {
    font-size: 14px;
  }

  .nav-dropdown {
    padding: 0;
    margin: 0;
    position: relative;
  }

  /* Do NOT show desktop dropdown on phones */
  .dropdown-menu {
    display: none !important;
  }

  .chevron {
    display: none;
  }
}
</style>