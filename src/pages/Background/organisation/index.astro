---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const topics = [
  {
    number: '01',
    label: 'Foundational document',
    title: 'How CPI (Maoist) Is Organised and Controlled',
    text: 'Membership, democratic centralism, leadership hierarchy, discipline and political control over armed formations, as defined in the party constitution.',
    href: `${BASE}/background/organisation/party-constitution/`,
    status: 'Read page',
  },
  {
    number: '02',
    label: 'Structure guide',
    title: 'Leadership and Committee Hierarchy',
    text: 'A future guide to the relationship between the Party Congress, Central Committee, Politburo, commissions and regional committees.',
    href: '#planned-pages',
    status: 'Planned',
  },
  {
    number: '03',
    label: 'Structure guide',
    title: 'Political and Armed Wings',
    text: 'A future guide explaining the formal relationship among party bodies, military commissions, the PLGA and associated mass structures.',
    href: '#planned-pages',
    status: 'Planned',
  },
];
---

<BaseLayout
  title="Organisation and Structure — The Naxal Archive"
  description="An analytical guide to CPI Maoist organisation, leadership, internal rules and political control over armed structures."
>
  <Header />

  <main class="organisation-page" id="top">
    <section class="hero">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={`${BASE}/background/`}>Background</a>
          <span>/</span>
          <span>Organisation & Structure</span>
        </nav>

        <span class="eyebrow">Background · Organisation</span>
        <h1>How the organisation is structured and controlled.</h1>
        <p>
          An examination of formal leadership, membership, internal discipline
          and the relationship between political and armed structures.
        </p>
      </div>
    </section>

    <section class="intro">
      <div class="shell intro-grid">
        <div>
          <span class="eyebrow">Reading the structure</span>
          <h2>Rules on paper and organisation in practice</h2>
        </div>
        <p>
          The party constitution describes an intended organisational model.
          Actual authority, staffing and territorial reach have varied across
          regions and periods, particularly under sustained security pressure.
        </p>
      </div>
    </section>

    <section class="topic-section" id="planned-pages">
      <div class="shell topic-grid">
        {topics.map((topic) => (
          <a class:list={['topic-card', topic.status === 'Planned' && 'planned']} href={topic.href}>
            <div class="card-meta">
              <span>{topic.number}</span>
              <span>{topic.label}</span>
            </div>
            <h2>{topic.title}</h2>
            <p>{topic.text}</p>
            <strong>{topic.status}{topic.status === 'Read page' ? ' →' : ''}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="next-section">
      <div class="shell next-grid">
        <a href={`${BASE}/background/ideology/`}><span>Related section</span><strong>← Ideology</strong></a>
        <a href={`${BASE}/background/major-incidents/`}><span>Next section</span><strong>Major Incidents →</strong></a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .organisation-page{--ink:#111b20;--paper:#f3efe5;--light:#fffdf8;--line:#cec6b8;--rust:#a34f32;--dark:#172327;background:var(--paper);color:var(--ink)}
  .eyebrow{font:800 11px/1.2 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:var(--rust)}
  .hero{padding:68px 0 70px;border-bottom:1px solid var(--line)}
  .breadcrumbs{display:flex;gap:9px;margin-bottom:52px;font:700 12px/1.2 system-ui,sans-serif;color:#7b756c}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--rust)}
  .hero h1{max-width:940px;margin:13px 0 24px;font:700 clamp(52px,7vw,90px)/.93 Georgia,serif;letter-spacing:-.05em}.hero p{max-width:730px;margin:0;font:400 20px/1.55 Georgia,serif;color:#5f5d57}
  .intro{padding:70px 0}.intro-grid{display:grid;grid-template-columns:1fr minmax(300px,.8fr);gap:70px;align-items:end}.intro h2{max-width:650px;margin:10px 0 0;font:700 clamp(38px,5vw,58px)/.98 Georgia,serif;letter-spacing:-.035em}.intro-grid>p{margin:0;font:400 17px/1.65 Georgia,serif;color:#625f59}
  .topic-section{padding-bottom:88px}.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.topic-card{min-height:390px;display:flex;flex-direction:column;padding:28px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--light);color:var(--ink);text-decoration:none}.card-meta{display:flex;justify-content:space-between;margin-bottom:68px;font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.topic-card h2{margin:0 0 17px;font:700 31px/1.04 Georgia,serif;letter-spacing:-.025em}.topic-card p{margin:0 0 28px;font:400 16px/1.6 Georgia,serif;color:#625f59}.topic-card strong{margin-top:auto;font:800 11px/1 system-ui,sans-serif}.topic-card:not(.planned):hover{background:var(--dark);color:#fffdf8}.topic-card:not(.planned):hover p{color:#d2d7d5}.topic-card.planned{cursor:default;background:#ece6da}.topic-card.planned strong{color:#8a8378}
  .next-section{border-top:1px solid var(--line);background:#e9e2d6}.next-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.next-grid a{padding:34px 0;color:var(--ink);text-decoration:none}.next-grid a:last-child{text-align:right}.next-grid span{display:block;margin-bottom:8px;font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.next-grid strong{font:700 23px/1 Georgia,serif}
  @media(max-width:900px){.intro-grid,.topic-grid{grid-template-columns:1fr}.topic-card{min-height:300px}.card-meta{margin-bottom:42px}}
  @media(max-width:600px){.hero{padding:42px 0}.breadcrumbs{margin-bottom:34px}.hero h1{font-size:47px}.hero p{font-size:17px}.intro{padding:50px 0}.intro-grid{gap:22px}.topic-section{padding-bottom:58px}.topic-card{min-height:280px;padding:24px}.next-grid{grid-template-columns:1fr}.next-grid a:last-child{border-top:1px solid var(--line);text-align:left}}
</style>
