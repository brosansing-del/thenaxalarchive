---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatCard from '../components/StatCard.astro';
---
<BaseLayout>
  <Header />
  <main>
    <section class="hero">
      <div class="shell hero-grid">
        <div>
          <div class="eyebrow">Research archive · India · 1967–present</div>
          <h1>Documenting the history, contraction and transformation of Left Wing Extremism in India.</h1>
          <p class="lede">A data-led archive bringing together historical context, official records, mapped trends, current reporting and development indicators.</p>
        </div>
        <aside class="hero-note">
          <strong>Editorial principle</strong>
          <p>Official data, archive-verified data and analysis are labelled separately. Every public figure should have a source trail and revision history.</p>
        </aside>
      </div>
    </section>

    <section class="section shell">
      <div class="section-head">
        <div><span class="eyebrow">Current picture</span><h2>Key indicators</h2></div>
        <p>Populate these cards only from validated datasets. No hard-coded headline numbers.</p>
      </div>
      <div class="stats-grid">
        <StatCard value="—" label="LWE-affected districts" />
        <StatCard value="—" label="Violent incidents, latest year" />
        <StatCard value="—" label="Civilian + security-force deaths" />
        <StatCard value="—" label="Most LWE-affected districts" />
      </div>
    </section>

    <section class="section section-tint">
      <div class="shell">
        <div class="section-head">
          <div><span class="eyebrow">Articles</span><h2>Latest reporting and analysis</h2></div>
          <p>One stream, with clear labels for News Desk, Analysis and Opinion.</p>
        </div>
        <div class="feature-grid">
          <article class="feature-card large"><span>News Desk</span><h3>Featured article title</h3><p>Articles will be managed as content entries, not hard-coded into the homepage.</p></article>
          <article class="feature-card"><span>Analysis</span><h3>Latest analysis</h3></article>
          <article class="feature-card"><span>Opinion</span><h3>Latest opinion</h3></article>
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="section-head">
        <div><span class="eyebrow">Data & Visuals</span><h2>Geography, people and infrastructure</h2></div>
        <p>The homepage will surface one flagship visual at a time; full dashboards live in Data & Visuals.</p>
      </div>
      <div class="visual-placeholder">
        <div><strong>Interactive district map</strong><p>CSV/JSON-driven map with year slider, district status and source metadata.</p></div>
        <div class="visual-actions"><a href="/data-visuals/">Open dashboard →</a></div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="shell">
        <div class="section-head light">
          <div><span class="eyebrow">Tracking Development</span><h2>What changes after violence declines?</h2></div>
          <p>Roads, telecom, banking, education, health, rehabilitation and district-level progress.</p>
        </div>
        <div class="development-grid">
          <div><strong>Roads & connectivity</strong><p>Year and district-level infrastructure progress.</p></div>
          <div><strong>Telecom</strong><p>Network expansion and tower rollout.</p></div>
          <div><strong>Public services</strong><p>Banking, post offices, education and health.</p></div>
          <div><strong>Rehabilitation</strong><p>Surrenders, packages and reintegration indicators.</p></div>
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="section-head">
        <div><span class="eyebrow">Methodology</span><h2>Three rules for every published figure</h2></div>
      </div>
      <div class="method-grid">
        <div><span>01 / SOURCE</span><h3>Primary before secondary</h3><p>Official records, court documents and first-hand reporting are prioritised.</p></div>
        <div><span>02 / DATE</span><h3>Every figure carries a reporting date</h3><p>Administrative classifications and totals change over time.</p></div>
        <div><span>03 / VERIFICATION</span><h3>Claims are cross-checked</h3><p>Conflicting figures, data gaps and important uncertainty are made visible.</p></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
