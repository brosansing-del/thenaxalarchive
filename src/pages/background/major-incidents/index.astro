---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const incidents = [
  {
    date: '6 February 2004', year: '2004', state: 'Odisha', place: 'Koraput',
    title: 'Koraput armoury and police installations raided', category: 'raid', categoryLabel: 'Arms and prison raid',
    toll: 'Three security personnel reported killed',
    text: 'People’s War cadres carried out coordinated attacks on the district armoury, police facilities and the jail. A large stock of firearms was taken, demonstrating the organisation’s ability at the time to concentrate personnel across a district headquarters.',
    significance: 'The raid materially expanded access to weapons and became an early marker of growing operational reach in Odisha.'
  },
  {
    date: '13 November 2005', year: '2005', state: 'Bihar', place: 'Jehanabad',
    title: 'Jehanabad prison attack', category: 'raid', categoryLabel: 'Arms and prison raid',
    toll: 'Hundreds of prisoners released; reported totals vary',
    text: 'Maoist cadres attacked the district jail and other local targets, releasing prisoners including detained Maoist members. A jailed leader of the rival Ranvir Sena was killed during the assault.',
    significance: 'The operation combined a prison break, political messaging and a display of temporary control in a district town.'
  },
  {
    date: '15 March 2007', year: '2007', state: 'Chhattisgarh', place: 'Rani Bodili, Bijapur',
    title: 'Rani Bodili camp attack', category: 'security', categoryLabel: 'Security forces targeted',
    toll: 'More than 50 people killed',
    text: 'Maoists attacked a residential school complex being used as a police and Salwa Judum-linked camp. Those killed included police personnel, Special Police Officers and others present at the site.',
    significance: 'The attack became one of the deadliest episodes associated with the conflict around Salwa Judum camps.'
  },
  {
    date: '15 February 2008', year: '2008', state: 'Odisha', place: 'Nayagarh',
    title: 'Nayagarh armoury raid', category: 'raid', categoryLabel: 'Arms and prison raid',
    toll: 'At least 13 police personnel and one civilian reported killed',
    text: 'Maoist groups attacked police facilities and armouries in and around Nayagarh, taking a substantial quantity of weapons and ammunition before withdrawing.',
    significance: 'The raid showed the continuing importance of armoury attacks to insurgent expansion beyond established strongholds.'
  },
  {
    date: '8 October 2009', year: '2009', state: 'Maharashtra', place: 'Laheri, Gadchiroli',
    title: 'Gadchiroli police ambush', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '17 police personnel killed',
    text: 'A police party was attacked in Gadchiroli district in an ambush involving gunfire and explosives.',
    significance: 'The incident underlined the growing intensity of the conflict in the Maharashtra–Chhattisgarh border region.'
  },
  {
    date: '6 April 2010', year: '2010', state: 'Chhattisgarh', place: 'Tarmetla–Chintalnar, Dantewada',
    title: 'Dantewada security-force ambush', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '76 security personnel killed',
    text: 'A CRPF and Chhattisgarh Police contingent was ambushed near Tarmetla during an operation in Dantewada district. Seventy-five CRPF personnel and one state police head constable were killed.',
    significance: 'It remains the largest single loss suffered by Indian security forces in a Maoist attack.'
  },
  {
    date: '17 May 2010', year: '2010', state: 'Chhattisgarh', place: 'Dantewada',
    title: 'Dantewada passenger-bus bombing', category: 'civilian', categoryLabel: 'Civilian and mixed target',
    toll: 'More than 30 people killed',
    text: 'An explosive device destroyed a passenger bus carrying civilians and Special Police Officers in Dantewada district.',
    significance: 'The civilian presence aboard the bus made the attack one of the most consequential mass-casualty incidents of the period.'
  },
  {
    date: '29 June 2010', year: '2010', state: 'Chhattisgarh', place: 'Narayanpur',
    title: 'Narayanpur ambush', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '26 CRPF personnel killed',
    text: 'A CRPF contingent was attacked in Narayanpur district during movement through a forested area.',
    significance: 'Coming within months of the Dantewada ambush, it reinforced 2010 as a peak year for security-force casualties.'
  },
  {
    date: '25 May 2013', year: '2013', state: 'Chhattisgarh', place: 'Jhiram Ghati, Darbha',
    title: 'Attack on the Congress Parivartan Yatra', category: 'political', categoryLabel: 'Political leadership targeted',
    toll: 'At least 27 killed; later accounts commonly place the toll at 29',
    text: 'CPI (Maoist) cadres attacked an Indian National Congress convoy. Those killed included Nand Kumar Patel, Mahendra Karma and other party workers and security personnel; former Union minister Vidya Charan Shukla later died from his injuries.',
    significance: 'The attack was exceptional for its concentrated targeting of a state-level political leadership. In September 2026, an NIA Special Court sentenced ten accused cadres in the case.'
  },
  {
    date: '11 March 2017', year: '2017', state: 'Chhattisgarh', place: 'Bheji, Sukma',
    title: 'Bheji attack', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '12 CRPF personnel killed',
    text: 'A CRPF road-opening party was attacked near Bheji in Sukma district.',
    significance: 'The incident preceded a second major attack in the same district six weeks later.'
  },
  {
    date: '24 April 2017', year: '2017', state: 'Chhattisgarh', place: 'Burkapal, Sukma',
    title: 'Burkapal ambush', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '25 CRPF personnel killed',
    text: 'Maoist cadres attacked a CRPF unit deployed in an area where road construction was being secured.',
    significance: 'At the time, it was the deadliest Maoist attack on security forces since 2010.'
  },
  {
    date: '22–23 April 2018', year: '2018', state: 'Maharashtra', place: 'Gadchiroli',
    title: 'Large Gadchiroli security operation', category: 'operation', categoryLabel: 'Security-force operation',
    toll: 'About 40 Maoist cadres reported killed across linked encounters',
    text: 'Security forces carried out major operations in Gadchiroli district, resulting in one of the largest reported Maoist losses in Maharashtra.',
    significance: 'Unlike the other entries around it, this was a state-initiated operation and signalled the increasing operational pressure on Maoist formations.'
  },
  {
    date: '1 May 2019', year: '2019', state: 'Maharashtra', place: 'Jambhulkheda, Gadchiroli',
    title: 'Gadchiroli vehicle bombing', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '15 C-60 commandos and one civilian driver killed',
    text: 'An explosive device struck a vehicle carrying Maharashtra Police C-60 commandos in Gadchiroli district.',
    significance: 'The attack was linked by investigators to retaliation for the major security operations conducted in the district in 2018.'
  },
  {
    date: '21 March 2020', year: '2020', state: 'Chhattisgarh', place: 'Minpa, Sukma',
    title: 'Minpa–Sukma ambush', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '17 security personnel killed',
    text: 'A joint security contingent was attacked in the Minpa area of Sukma district after an operation.',
    significance: 'The incident demonstrated that Maoist formations retained the capacity to inflict substantial losses despite a narrower geographic footprint.'
  },
  {
    date: '3 April 2021', year: '2021', state: 'Chhattisgarh', place: 'Bijapur–Sukma border',
    title: 'Bijapur–Sukma encounter', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '22 security personnel killed',
    text: 'A joint operation led to a prolonged exchange of fire in the border area between Bijapur and Sukma districts. Personnel from the CRPF and state police were killed.',
    significance: 'It was among the largest single-day security-force losses of the post-2010 period.'
  },
  {
    date: '26 April 2023', year: '2023', state: 'Chhattisgarh', place: 'Aranpur, Dantewada',
    title: 'Aranpur IED attack', category: 'security', categoryLabel: 'Security forces targeted',
    toll: '10 DRG personnel and one civilian driver killed',
    text: 'An explosive device struck a vehicle carrying District Reserve Guard personnel in Dantewada district.',
    significance: 'The attack showed the continuing threat from concealed explosives even as overall LWE violence and geographic spread declined.'
  },
];

const filters = [
  { key: 'all', label: 'All incidents' },
  { key: 'security', label: 'Security forces targeted' },
  { key: 'raid', label: 'Arms and prison raids' },
  { key: 'political', label: 'Political target' },
  { key: 'civilian', label: 'Civilian or mixed target' },
  { key: 'operation', label: 'Security operation' },
];
---

<BaseLayout
  title="Major Incidents That Shaped the Maoist Insurgency — The Naxal Archive"
  description="A sourced and filterable chronology of major Maoist attacks, political targets and security operations in India from 2004 to 2023."
>
  <Header />

  <main class="incidents-page" id="top">
    <section class="incidents-hero">
      <div class="shell hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href={`${BASE}/background/`}>Background</a><span>/</span><span>Major Incidents</span>
          </nav>
          <span class="eyebrow">Chronology · 2004–2023</span>
          <h1>Major incidents that shaped the Maoist insurgency.</h1>
          <p>
            A selective record of attacks, political turning points and major
            security operations that changed the scale, geography or public
            understanding of the conflict.
          </p>
        </div>

        <aside class="scope-card">
          <span>Scope</span>
          <strong>{incidents.length} selected incidents</strong>
          <dl>
            <div><dt>Period</dt><dd>2004–2023</dd></div>
            <div><dt>States represented</dt><dd>Four</dd></div>
            <div><dt>Updated</dt><dd>September 2026</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="selection-note">
      <div class="shell note-grid">
        <strong>Selection criteria</strong>
        <p>
          Inclusion reflects scale, political consequence, operational impact
          or significance in the later trajectory of the insurgency. This is
          not a complete list of LWE-related violence. Reported casualty totals
          may differ across contemporary and later sources.
        </p>
      </div>
    </section>

    <section class="timeline-section">
      <div class="shell">
        <div class="timeline-heading">
          <div><span class="eyebrow">Interactive record</span><h2>Filter the timeline</h2></div>
          <p><span id="result-count">{incidents.length}</span> incidents shown. Select an incident to read why it mattered.</p>
        </div>

        <div class="filters" role="group" aria-label="Filter incidents by type">
          {filters.map((filter, index) => (
            <button type="button" class:list={['filter-button', index === 0 && 'active']} data-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>
              {filter.label}
            </button>
          ))}
        </div>

        <div class="timeline" id="incident-timeline">
          {incidents.map((incident, index) => (
            <article class="incident" data-category={incident.category}>
              <div class="marker"><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
              <div class="date"><strong>{incident.year}</strong><span>{incident.date}</span></div>
              <details class="incident-card">
                <summary>
                  <div class="summary-meta"><span>{incident.state}</span><span>{incident.categoryLabel}</span></div>
                  <h3>{incident.title}</h3>
                  <p>{incident.toll}</p>
                  <span class="expand-label"><span class="closed">View details</span><span class="opened">Close details</span></span>
                </summary>
                <div class="incident-detail">
                  <div><span>What happened</span><p>{incident.text}</p></div>
                  <div><span>Why it matters</span><p>{incident.significance}</p></div>
                  <small>{incident.place}</small>
                </div>
              </details>
            </article>
          ))}
        </div>

        <div class="empty-state" id="empty-state" hidden>No incidents match this filter.</div>
      </div>
    </section>

    <section class="sources-section">
      <div class="shell sources-grid">
        <div><span class="eyebrow">Source trail</span><h2>Key references</h2></div>
        <div class="source-list">
          <a href="https://www.mha.gov.in/MHA1/Par2017/pdfs/par2016-pdfs/rs-270716/1096%20E.pdf" target="_blank" rel="noreferrer"><span>Government of India</span><strong>Rajya Sabha reply on the 6 April 2010 Dantewada attack</strong><small>Official casualty total and inquiry summary ↗</small></a>
          <a href="https://www.mha.gov.in/MHA1/Par2017/pdfs/par2021-pdfs/LS-27072021/1187.pdf" target="_blank" rel="noreferrer"><span>Government of India</span><strong>Lok Sabha reply on LWE attacks</strong><small>Official account of the April 2021 encounter and comparative context ↗</small></a>
          <a href="https://nia.gov.in/press-releases" target="_blank" rel="noreferrer"><span>National Investigation Agency</span><strong>Jhiram Ghati case releases and September 2026 sentencing</strong><small>Investigation and judicial update ↗</small></a>
          <a href="https://timesofindia.indiatimes.com/city/kolkata/naxalites-attack-koraput-town-loot-police-stations/articleshow/482576.cms" target="_blank" rel="noreferrer"><span>Contemporary report</span><strong>Koraput raid, February 2004</strong><small>Date, targets and immediate reporting ↗</small></a>
          <a href="https://www.hindustantimes.com/india-news/10-security-personnel-injured-in-ied-blast-by-maoists-in-maharashtra-s-gadchiroli/story-bhomMavho0fpHGZta0t3WN.html" target="_blank" rel="noreferrer"><span>Contemporary report</span><strong>Gadchiroli attack, May 2019</strong><small>Casualties and incident context ↗</small></a>
        </div>
      </div>
    </section>

    <section class="next-section">
      <div class="shell next-grid">
        <a href={`${BASE}/background/organisation/`}><span>Previous section</span><strong>← Organisation & Structure</strong></a>
        <a href={`${BASE}/background/`}><span>Background index</span><strong>View all sections →</strong></a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll('.filter-button'));
  const cards = Array.from(document.querySelectorAll('.incident'));
  const count = document.querySelector('#result-count');
  const empty = document.querySelector('#empty-state');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') || 'all';
      let visible = 0;

      buttons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      cards.forEach((card) => {
        const show = filter === 'all' || card.getAttribute('data-category') === filter;
        card.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });

      if (count) count.textContent = String(visible);
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    });
  });
</script>

<style>
  html{scroll-behavior:smooth}.incidents-page{--ink:#111b20;--paper:#f3efe5;--light:#fffdf8;--line:#cec6b8;--rust:#a34f32;--dark:#172327;background:var(--paper);color:var(--ink)}.eyebrow{font:800 11px/1.2 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:var(--rust)}
  .incidents-hero{padding:68px 0 64px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(270px,.6fr);gap:72px;align-items:end}.breadcrumbs{display:flex;gap:9px;margin-bottom:52px;font:700 12px/1.2 system-ui,sans-serif;color:#7b756c}.breadcrumbs a{color:inherit;text-decoration:none}.incidents-hero h1{max-width:900px;margin:13px 0 24px;font:700 clamp(52px,7vw,90px)/.93 Georgia,serif;letter-spacing:-.05em}.incidents-hero p{max-width:750px;margin:0;font:400 20px/1.55 Georgia,serif;color:#5f5d57}.scope-card{padding:25px;border-top:3px solid var(--rust);background:#e9e2d6}.scope-card>span{display:block;margin-bottom:25px;font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:var(--rust)}.scope-card>strong{display:block;margin-bottom:18px;font:700 27px/1.05 Georgia,serif}.scope-card dl{margin:0}.scope-card dl div{display:flex;justify-content:space-between;gap:20px;padding:11px 0;border-top:1px solid var(--line)}.scope-card dt,.scope-card dd{margin:0;font:700 11px/1.3 system-ui,sans-serif}.scope-card dt{color:#7d766c}.scope-card dd{text-align:right}
  .selection-note{padding:28px 0;background:var(--dark);color:#fffdf8}.note-grid{display:grid;grid-template-columns:190px minmax(0,780px);gap:42px}.note-grid strong{font:800 10px/1.3 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:#d69b78}.note-grid p{margin:0;font:400 15px/1.6 Georgia,serif;color:#d2d7d5}
  .timeline-section{padding:80px 0 96px}.timeline-heading{display:grid;grid-template-columns:1fr minmax(280px,460px);gap:70px;align-items:end;margin-bottom:34px}.timeline-heading h2,.sources-grid h2{margin:10px 0 0;font:700 clamp(40px,5vw,60px)/.98 Georgia,serif;letter-spacing:-.035em}.timeline-heading>p{margin:0;font:400 16px/1.6 Georgia,serif;color:#625f59}.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:50px}.filter-button{min-height:42px;padding:0 16px;border:1px solid var(--line);border-radius:100px;background:transparent;color:var(--ink);font:750 12px/1 system-ui,sans-serif;cursor:pointer}.filter-button:hover,.filter-button.active{border-color:var(--dark);background:var(--dark);color:#fffdf8}
  .timeline{border-top:1px solid var(--line)}.incident{display:grid;grid-template-columns:62px 170px minmax(0,1fr);gap:28px;padding:36px 0;border-bottom:1px solid var(--line)}.incident[hidden]{display:none}.marker{position:relative;display:flex;justify-content:center}.marker span{position:relative;z-index:2;width:38px;height:38px;display:grid;place-items:center;border-radius:50%;background:var(--dark);color:#fffdf8;font:800 9px/1 system-ui,sans-serif}.marker i{position:absolute;top:38px;bottom:-37px;width:1px;background:var(--line)}.incident:last-child .marker i{display:none}.date strong{display:block;font:700 28px/1 Georgia,serif}.date span{display:block;margin-top:8px;font:700 11px/1.4 system-ui,sans-serif;color:#777168}.incident-card{background:var(--light);border:1px solid var(--line)}.incident-card summary{position:relative;padding:25px 28px;cursor:pointer;list-style:none}.incident-card summary::-webkit-details-marker{display:none}.summary-meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:19px}.summary-meta span{font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.09em;color:var(--rust)}.incident-card h3{max-width:700px;margin:0 0 12px;font:700 29px/1.04 Georgia,serif;letter-spacing:-.025em}.incident-card summary>p{margin:0 0 24px;font:700 14px/1.45 system-ui,sans-serif;color:#5e5a54}.expand-label{font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.08em}.opened{display:none}.incident-card[open] .closed{display:none}.incident-card[open] .opened{display:inline}.incident-detail{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding:28px;border-top:1px solid var(--line);background:#ebe5da}.incident-detail span{display:block;margin-bottom:10px;font:800 9px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.incident-detail p{margin:0;font:400 15px/1.65 Georgia,serif;color:#56534e}.incident-detail small{grid-column:1/-1;padding-top:18px;border-top:1px solid var(--line);font:700 11px/1 system-ui,sans-serif;color:#777168}.empty-state{padding:40px;border:1px solid var(--line);text-align:center;font:700 16px/1.4 Georgia,serif}
  .sources-section{padding:80px 0;border-top:1px solid var(--line);background:#e9e2d6}.sources-grid{display:grid;grid-template-columns:minmax(250px,.7fr) minmax(0,1.3fr);gap:80px}.source-list{border-top:1px solid #bdb3a5}.source-list a{display:block;padding:22px 0;border-bottom:1px solid #bdb3a5;color:var(--ink);text-decoration:none}.source-list a>span{display:block;margin-bottom:8px;font:800 9px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.source-list strong{display:block;font:700 19px/1.25 Georgia,serif}.source-list small{display:block;margin-top:7px;font:600 11px/1.4 system-ui,sans-serif;color:#746e65}.source-list a:hover strong{color:var(--rust)}
  .next-section{border-top:1px solid var(--line)}.next-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.next-grid a{padding:34px 0;color:var(--ink);text-decoration:none}.next-grid a:last-child{text-align:right}.next-grid span{display:block;margin-bottom:8px;font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.next-grid strong{font:700 22px/1.1 Georgia,serif}
  @media(max-width:900px){.hero-grid,.timeline-heading,.sources-grid{grid-template-columns:1fr;gap:38px}.scope-card{max-width:520px}.incident{grid-template-columns:52px 130px minmax(0,1fr);gap:18px}.incident-detail{grid-template-columns:1fr}}
  @media(max-width:650px){.incidents-hero{padding:42px 0}.breadcrumbs{margin-bottom:34px}.incidents-hero h1{font-size:47px}.incidents-hero p{font-size:17px}.note-grid{grid-template-columns:1fr;gap:12px}.timeline-section{padding:52px 0 62px}.filters{flex-wrap:nowrap;overflow-x:auto;margin-right:-20px;padding-right:20px}.filter-button{flex:0 0 auto}.incident{grid-template-columns:42px minmax(0,1fr);gap:10px 14px}.marker{grid-row:1/span 2}.marker span{width:34px;height:34px}.marker i{top:34px;bottom:-37px}.date{grid-column:2}.incident-card{grid-column:2}.incident-card summary{padding:22px}.incident-card h3{font-size:25px}.incident-detail{padding:22px}.sources-section{padding:54px 0}.next-grid{grid-template-columns:1fr}.next-grid a:last-child{border-top:1px solid var(--line);text-align:left}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
