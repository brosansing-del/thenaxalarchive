---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const pageUrl = (path: string) =>
  `${BASE}/${path.replace(/^\/+/, '')}`;
---

<BaseLayout
  title="Data & Visuals — The Naxal Archive"
  description="Interactive datasets, maps and visual records on Left Wing Extremism in India."
>
  <Header />

  <main class="dv-index shell">

    <!-- INTRO -->
    <section class="intro">
      <span class="eyebrow">Data & Visuals</span>

      <h1>
        Explore the archive
        through data.
      </h1>

      <p>
        Structured records, source-led tables and visual summaries covering
        geography, leadership, infrastructure and long-term change.
      </p>
    </section>


    <!-- DATASET 01 -->
    <section class="entry-grid">

      <a
        class="entry-card"
        href={pageUrl('data-visuals/senior-leadership-exits/')}
      >

        <div class="entry-image leadership-image">
          <img
            src={`${BASE}/images/data/leadership/02.jpg`}
            alt="Senior CPI (Maoist) leadership record"
            loading="eager"
          />
        </div>

        <div class="entry-copy">

          <span class="entry-kicker">
            Leadership · Jan 2025–Feb 2026
          </span>

          <h2>
            Senior CPI (Maoist) Leadership
            Attrition & Surrenders
          </h2>

          <p>
            A searchable visual record of PBM and CCM-level exits
            listed in the source dataset.
          </p>

          <strong class="explore-link">
            Explore data →
          </strong>

        </div>

      </a>


      <!-- DATASET 02 -->

      <a
        class="entry-card"
        href={pageUrl('data-visuals/infrastructure-targeting/')}
      >

        <div class="visual-preview infrastructure-preview">

          <span>Infrastructure targeting</span>

          <div class="preview-bars">
            <i style="height:100%"></i>
            <i style="height:95%"></i>
            <i style="height:93%"></i>
            <i style="height:57%"></i>
            <i style="height:25%"></i>
          </div>

          <div class="preview-years">
            <small>2021</small>
            <small>2022</small>
            <small>2023</small>
            <small>2024</small>
            <small>2025</small>
          </div>

        </div>

        <div class="entry-copy">

          <span class="entry-kicker">
            Infrastructure · 2021–2025
          </span>

          <h2>
            Infrastructure Targeting
            by LWE Outfits
          </h2>

          <p>
            Explore recorded targeting of roads, telecom towers,
            railways and other infrastructure by year and state.
          </p>

          <strong class="explore-link">
            Explore data →
          </strong>

        </div>

      </a>


      <!-- DATASET 03 -->

      <a
        class="entry-card"
        href={pageUrl('data-visuals/lwe-surrenders/')}
      >

        <div class="visual-preview surrender-preview">

          <span>Annual surrender trend</span>

          <div class="trend-line">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>

          <strong>2004 → 2026</strong>

        </div>

        <div class="entry-copy">

          <span class="entry-kicker">
            Surrenders · 2004–2026
          </span>

          <h2>
            LWE Surrenders
            Since 2004
          </h2>

          <p>
            Explore year-wise and state-wise surrender records
            across more than two decades.
          </p>

          <strong class="explore-link">
            Explore data →
          </strong>

        </div>

      </a>

    </section>

  </main>

  <Footer />
</BaseLayout>


<style>

  .dv-index {
    padding-top: 54px;
    padding-bottom: 80px;
  }


  /* INTRO */

  .intro {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .eyebrow {
    display: block;

    font-family: system-ui, sans-serif;
    font-size: 10px;
    font-weight: 800;

    letter-spacing: .12em;
    text-transform: uppercase;

    color: #9c4f37;
  }

  .intro h1 {
    margin: 9px 0 18px;

    font-family: Georgia, serif;
    font-size: clamp(42px, 6vw, 70px);
    font-weight: 700;
    line-height: .98;

    letter-spacing: -.035em;

    color: #111b20;
  }

  .intro p {
    margin: 0;

    font-family: Georgia, serif;
    font-size: 18px;
    line-height: 1.55;

    color: #596268;
  }


  /* DATASET GRID */

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 22px;
  }


  /* CARD */

  .entry-card {
    min-width: 0;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    background: #fffdf8;

    border: 1px solid #d8d0c3;

    color: #111b20;
    text-decoration: none;

    transition:
      transform .2s ease,
      border-color .2s ease;
  }

  @media (hover: hover) and (pointer: fine) {

    .entry-card:hover {
      transform: translateY(-3px);
      border-color: #9c765e;
    }

  }


  /* LEADERSHIP IMAGE */

  .entry-image {
    width: 100%;
    height: 330px;

    overflow: hidden;

    background: #172127;
  }

  .entry-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: contain;
    object-position: center;

    filter: grayscale(100%);
  }


  /* CONTENT */

  .entry-copy {
    flex: 1;

    display: flex;
    flex-direction: column;

    padding: 34px 34px 30px;
  }

  .entry-kicker {
    margin-bottom: 18px;

    font-family: system-ui, sans-serif;
    font-size: 10px;
    font-weight: 800;

    letter-spacing: .11em;
    text-transform: uppercase;

    color: #9c4f37;
  }

  .entry-copy h2 {
    margin: 0 0 18px;

    font-family: Georgia, serif;
    font-size: clamp(28px, 3vw, 39px);
    font-weight: 700;
    line-height: 1.04;

    letter-spacing: -.025em;

    color: #111b20;
  }

  .entry-copy p {
    margin: 0 0 30px;

    font-family: Georgia, serif;
    font-size: 17px;
    line-height: 1.55;

    color: #65645f;
  }

  .explore-link {
    margin-top: auto;

    font-family: Georgia, serif;
    font-size: 18px;

    color: #111b20;
  }


  /* VISUAL PREVIEWS */

  .visual-preview {
    height: 330px;

    padding: 32px;

    display: flex;
    flex-direction: column;

    background: #ebe5d9;

    border-bottom: 1px solid #d8d0c3;
  }

  .visual-preview > span {
    font-family: system-ui, sans-serif;
    font-size: 10px;
    font-weight: 800;

    letter-spacing: .12em;
    text-transform: uppercase;

    color: #8d4935;
  }


  /* INFRASTRUCTURE PREVIEW */

  .preview-bars {
    flex: 1;

    display: flex;
    align-items: flex-end;
    justify-content: space-around;

    gap: 18px;

    padding: 38px 12px 12px;
  }

  .preview-bars i {
    width: 38px;

    display: block;

    background: #b78668;

    border-radius: 2px 2px 0 0;
  }

  .preview-years {
    display: flex;
    justify-content: space-around;

    padding: 0 8px;
  }

  .preview-years small {
    font-family: system-ui, sans-serif;
    font-size: 9px;
    font-weight: 700;

    color: #59544e;
  }


  /* SURRENDER PREVIEW */

  .surrender-preview {
    justify-content: space-between;

    background: #182326;

    color: #fffdf8;
  }

  .surrender-preview > span {
    color: #d4a88a;
  }

  .surrender-preview > strong {
    font-family: Georgia, serif;
    font-size: 31px;
    font-weight: 700;
  }

  .trend-line {
    height: 120px;

    display: flex;
    align-items: flex-end;
    gap: 9px;
  }

  .trend-line i {
    flex: 1;

    min-width: 8px;

    background: #c4a284;
  }

  .trend-line i:nth-child(1) {
    height: 26%;
  }

  .trend-line i:nth-child(2) {
    height: 56%;
  }

  .trend-line i:nth-child(3) {
    height: 39%;
  }

  .trend-line i:nth-child(4) {
    height: 62%;
  }

  .trend-line i:nth-child(5) {
    height: 100%;
  }

  .trend-line i:nth-child(6) {
    height: 34%;
  }


  /*
    TABLET / iPAD
  */

  @media (max-width: 900px) {

    .entry-grid {
      grid-template-columns: 1fr;
    }

    .entry-card {
      max-width: 720px;
    }

  }


  /*
    iPHONE / SMALL MOBILE
  */

  @media (max-width: 600px) {

    .dv-index {
      padding-top: 30px;
      padding-bottom: 55px;
    }

    .intro {
      margin-bottom: 30px;
    }

    .intro h1 {
      font-size: 45px;
      line-height: .98;
    }

    .intro p {
      font-size: 16px;
      line-height: 1.5;
    }


    /*
      Critical iOS fix:
      do not let Safari stretch/crop portrait images.
    */

    .entry-image {
      height: 245px;
    }

    .entry-image img {
      width: 100%;
      height: 100%;

      object-fit: contain;
      object-position: center;

      display: block;
    }


    .visual-preview {
      height: 245px;
      padding: 24px;
    }


    .entry-copy {
      padding: 26px 26px 28px;
    }

    .entry-copy h2 {
      font-size: 32px;
      line-height: 1.05;
    }

    .entry-copy p {
      font-size: 16px;
      line-height: 1.52;
      margin-bottom: 25px;
    }

    .explore-link {
      font-size: 17px;
    }


    .preview-bars {
      gap: 8px;
      padding-top: 28px;
    }

    .preview-bars i {
      width: 26px;
    }

  }


  /*
    VERY SMALL iPHONES
  */

  @media (max-width: 390px) {

    .intro h1 {
      font-size: 40px;
    }

    .entry-copy h2 {
      font-size: 29px;
    }

    .entry-image,
    .visual-preview {
      height: 220px;
    }

  }

</style>