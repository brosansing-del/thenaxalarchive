---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import Papa from 'papaparse';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const csvPath = path.join(process.cwd(), 'public', 'data', 'lwe-surrenders.csv');
const csvText = fs.readFileSync(csvPath, 'utf8');
const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true, dynamicTyping: true });
const rows = parsed.data;

const stateColumns = [
  'Andhra Pradesh','Assam','Bihar','Chhattisgarh','Jharkhand','Karnataka',
  'Kerala','Madhya Pradesh','Maharashtra','Odisha','Tamil Nadu','Telangana',
  'Uttar Pradesh','West Bengal'
];

const totalAll = rows.reduce((sum, r) => sum + Number(r.total || 0), 0);
const peak = rows.reduce((a, b) => Number(a.total) > Number(b.total) ? a : b);
const latestFull = rows.find((r) => r.year === 2025);
const partial2026 = rows.find((r) => r.year === 2026);

const stateTotals = stateColumns.map((state) => ({
  state,
  total: rows.reduce((sum, r) => sum + Number(r[state] || 0), 0),
})).sort((a,b) => b.total - a.total);

const maxAnnual = Math.max(...rows.map((r) => Number(r.total || 0)));
const maxState = Math.max(...stateTotals.map((r) => r.total));
---

<BaseLayout title="LWE Surrenders Since 2004 — The Naxal Archive" description="Year-wise and state-wise LWE surrender records from 2004 onward.">
  <Header />
  <main class="surrender-page">
    <section class="shell intro">
      <div class="crumbs">
        <a href={`${BASE}/`}>Home</a><span>›</span>
        <a href={`${BASE}/data-visuals/`}>Data & Visuals</a><span>›</span>
        <strong>LWE surrenders</strong>
      </div>
      <span class="eyebrow">Data & Visuals · Surrenders</span>
      <h1>LWE Surrenders Since 2004</h1>
    </section>

    <section class="shell explorer">
      <div class="section-headline">
        <div>
          <span class="eyebrow">Annual trend</span>
          <h2>Year-wise surrender record</h2>
        </div>
        <a class="download" href={`${BASE}/data/lwe-surrenders.csv`} download>Download CSV ↓</a>
      </div>

      <div class="trend-card">
        <div class="trend-bars" id="trendBars">
          {rows.map((r) => (
            <button
              class:list={["trend-year", r.year === 2025 && "is-highlight", r.year === 2026 && "is-partial"]}
              type="button"
              data-year={r.year}
              aria-label={`${r.year}: ${r.total} surrenders`}
              title={`${r.year}: ${r.total}${r.year === 2026 ? ' (till 24 Mar)' : ''}`}
            >
              <span class="bar-shell">
                <i style={`height:${Math.max(4, (Number(r.total)/maxAnnual)*220)}px`}></i>
              </span>
              <strong>{r.total}</strong>
              <small>{r.year === 2026 ? '2026*' : r.year}</small>
            </button>
          ))}
        </div>
        <p class="partial-note">* 2026 figure is partial: till 24 March 2026.</p>
      </div>

      <div class="controls">
        <label>
          <span>Year</span>
          <select id="yearFilter">
            <option value="">All years</option>
            {rows.map((r) => <option value={String(r.year)}>{r.year}{r.year === 2026 ? ' (till 24 Mar)' : ''}</option>)}
          </select>
        </label>
        <label>
          <span>State</span>
          <select id="stateFilter">
            <option value="">All states</option>
            {stateColumns.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <button id="resetFilters" type="button">Reset</button>
      </div>

      <div class="focus-grid">
        <article class="focus-card">
          <span class="eyebrow">Selected view</span>
          <strong id="focusValue">{totalAll.toLocaleString('en-IN')}</strong>
          <p id="focusLabel">Total surrenders recorded across all years and states</p>
        </article>

        <article class="focus-card detail-card">
          <span class="eyebrow">Context</span>
          <p><strong>Peak annual total:</strong> {peak.total.toLocaleString('en-IN')} in {peak.year}</p>
          <p><strong>2025:</strong> {latestFull.total.toLocaleString('en-IN')}</p>
          <p><strong>2026 partial:</strong> {partial2026.total.toLocaleString('en-IN')} till 24 March</p>
        </article>
      </div>

      <div class="split-grid">
        <article class="panel">
          <div class="panel-head">
            <div>
              <span class="eyebrow">Geography</span>
              <h2 id="stateTitle">State totals · all years</h2>
            </div>
          </div>
          <div id="stateBars" class="state-bars">
            {stateTotals.map((d) => (
              <div class="state-row" data-state={d.state} data-total={d.total}>
                <span>{d.state}</span>
                <div class="track"><i style={`width:${(d.total/maxState)*100}%`}></i></div>
                <strong>{d.total.toLocaleString('en-IN')}</strong>
              </div>
            ))}
          </div>
        </article>

        <article class="panel">
          <div class="panel-head">
            <div>
              <span class="eyebrow">Table</span>
              <h2>Year-wise totals</h2>
            </div>
          </div>
          <div class="mini-table-wrap">
            <table class="mini-table">
              <thead><tr><th>Year</th><th>Total</th><th>Period</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr data-year={r.year}>
                    <td>{r.year}</td>
                    <td>{Number(r.total).toLocaleString('en-IN')}</td>
                    <td>{r.period}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ rows, stateColumns }}>
  const yearFilter = document.querySelector('#yearFilter');
  const stateFilter = document.querySelector('#stateFilter');
  const reset = document.querySelector('#resetFilters');
  const focusValue = document.querySelector('#focusValue');
  const focusLabel = document.querySelector('#focusLabel');
  const stateBars = document.querySelector('#stateBars');
  const stateTitle = document.querySelector('#stateTitle');
  const trendButtons = [...document.querySelectorAll('.trend-year')];

  function fmt(n){ return Number(n || 0).toLocaleString('en-IN'); }

  function renderStateBars(selectedYear = '') {
    const dataset = selectedYear ? rows.filter(r => String(r.year) === String(selectedYear)) : rows;
    const values = stateColumns.map(state => ({
      state,
      total: dataset.reduce((sum, r) => sum + Number(r[state] || 0), 0)
    })).sort((a,b) => b.total - a.total);

    const max = Math.max(...values.map(v => v.total), 1);
    stateBars.innerHTML = values
      .filter(v => v.total > 0)
      .map(v => `
        <div class="state-row" data-state="${v.state}">
          <span>${v.state}</span>
          <div class="track"><i style="width:${(v.total/max)*100}%"></i></div>
          <strong>${fmt(v.total)}</strong>
        </div>`).join('');
    stateTitle.textContent = selectedYear ? `State totals · ${selectedYear}` : 'State totals · all years';
  }

  function update() {
    const year = yearFilter.value;
    const state = stateFilter.value;
    let value = 0;

    if (year && state) {
      const row = rows.find(r => String(r.year) === year);
      value = row ? Number(row[state] || 0) : 0;
      focusLabel.textContent = `${state} · ${year}`;
    } else if (year) {
      const row = rows.find(r => String(r.year) === year);
      value = row ? Number(row.total || 0) : 0;
      focusLabel.textContent = `All states · ${year}${year === '2026' ? ' (till 24 March)' : ''}`;
    } else if (state) {
      value = rows.reduce((sum, r) => sum + Number(r[state] || 0), 0);
      focusLabel.textContent = `${state} · all years`;
    } else {
      value = rows.reduce((sum, r) => sum + Number(r.total || 0), 0);
      focusLabel.textContent = 'Total surrenders recorded across all years and states';
    }

    focusValue.textContent = fmt(value);
    renderStateBars(year);

    trendButtons.forEach(btn => {
      btn.classList.toggle('is-selected', year && btn.dataset.year === year);
      btn.classList.toggle('is-muted', year && btn.dataset.year !== year);
    });
  }

  yearFilter.addEventListener('change', update);
  stateFilter.addEventListener('change', update);

  trendButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      yearFilter.value = btn.dataset.year;
      update();
    });
  });

  reset.addEventListener('click', () => {
    yearFilter.value = '';
    stateFilter.value = '';
    update();
  });
</script>

<style>
