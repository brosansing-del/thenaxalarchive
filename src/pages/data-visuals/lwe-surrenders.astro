:#fffdf8;border:1px solid #d9d1c3;border-top:0;padding:14px}.controls label{display:grid;gap:5px;font:800 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.07em;color:#756e65}.controls select{min-height:42px;border:1px solid #c9c0b3;background:#fff;padding:0 12px;font:600 13px system-ui,sans-serif;color:#172127}.controls button{min-height:42px;border:1px solid #afa598;background:#f2ede4;padding:0 18px;font-weight:750;cursor:pointer}.focus-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:14px;margin:18px 0}.focus-card{background:#111b20;color:#fffdf8;padding:24px;border:1px solid #111b20}.focus-card .eyebrow{color:#d3aa8a}.focus-card>strong{display:block;font:700 58px/1 Georgia,serif;margin:10px 0 8px}.focus-card p{margin:0;font:500 13px/1.5 system-ui,sans-serif;color:#e2ddd5}.detail-card{background:#fffdf8;color:#111b20;border-color:#d9d1c3}.detail-card .eyebrow{color:#9c4f37}.detail-card p{color:#514c46;margin:6px 0}.split-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:14px}.panel{background:#fffdf8;border:1px solid #d9d1c3;padding:20px}.panel-head{margin-bottom:18px}.state-bars{display:grid;gap:12px}.state-row{display:grid;grid-template-columns:140px 1fr 60px;gap:10px;align-items:center;font:650 12px system-ui,sans-serif}.track{height:12px;background:#eee8df}.track i{display:block;height:100%;background:#b99b80}.state-row strong{text-align:right}.mini-table-wrap{max-height:480px;overflow:auto;border:1px solid #e4ddd2}.mini-table{width:100%;border-collapse:collapse}.mini-table th{position:sticky;top:0;background:#e9e2d6;text-align:left;padding:10px;font:800 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.06em}.mini-table td{padding:9px 10px;border-top:1px solid #e8e1d6;font:600 12px system-ui,sans-serif}.mini-table td:nth-child(2){font-weight:800}.mini-table tr:hover{background:#faf6ee}@media(max-width:900px){.focus-grid,.split-grid{grid-template-columns:1fr}.state-row{grid-template-columns:120px 1fr 54px}.trend-bars{gap:4px}.trend-year{min-width:38px}.bar-shell i{width:20px}}@media(max-width:600px){.section-headline{align-items:flex-start;flex-direction:column}.controls{grid-template-columns:1fr}.trend-card{padding-left:10px;padding-right:10px}.state-row{grid-template-columns:100px 1fr 44px}.intro h1{font-size:44px}}
</style>
