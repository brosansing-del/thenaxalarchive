---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');

const records = [
  [1980,84,84,0,17],[1981,92,91,1,28],[1982,126,120,6,20],[1983,95,95,0,26],[1984,115,109,6,23],
  [1985,116,111,5,66],[1986,146,146,0,0],[1987,198,170,28,53],[1988,188,171,17,82],[1989,240,217,23,91],
  [1990,413,395,18,151],[1991,474,397,77,125],[1992,503,418,85,285],[1993,470,408,62,178],[1994,377,333,44,139],
  [1995,396,376,20,92],[1996,541,478,63,187],[1997,584,505,79,187],[1998,489,397,92,296],[1999,598,502,96,261],
  [2000,550,452,98,254],[2001,564,439,125,182],[2002,482,382,100,141],[2003,515,410,105,214],[2004,566,465,101,86],
  [2005,677,524,153,225],[2006,678,521,157,274],[2007,696,460,236,141],[2008,719,488,231,202],[2009,908,591,317,221],
  [2010,1005,720,285,172],[2011,611,469,142,99],[2012,415,301,114,74],[2013,397,282,115,100],[2014,310,222,88,63],
  [2015,230,171,59,89],[2016,278,213,65,222],[2017,263,188,75,136],[2018,240,173,67,225],[2019,202,150,52,145],
  [2020,183,140,43,103],[2021,147,97,50,126],[2022,98,82,16,57],[2023,139,107,32,50],[2024,151,132,19,290],
  [2025,100,64,36,364],[2026,11,6,5,59],
];

const decades = [
  { label:'1980s', start:1980, end:1989, total:1400, civilians:1314, forces:86, extremists:406 },
  { label:'1990s', start:1990, end:1999, total:4845, civilians:4209, forces:636, extremists:1901 },
  { label:'2000s', start:2000, end:2009, total:6355, civilians:4732, forces:1623, extremists:1940 },
  { label:'2010s', start:2010, end:2019, total:3951, civilians:2889, forces:1062, extremists:1325 },
  { label:'2020–26', start:2020, end:2026, total:829, civilians:628, forces:201, extremists:1049 },
];
---

<BaseLayout
  title="Deaths Linked to LWE Incidents Since 1980 — The Naxal Archive"
  description="An interactive year-wise record of civilian, security-force and extremist deaths linked to Left Wing Extremism in India from 1980 to 2026."
>
  <Header />

  <main class="fatalities-page" id="top">
    <section class="fatalities-hero">
      <div class="shell hero-grid">
        <div>
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href={`${BASE}/data-visuals/`}>Data & Visuals</a><span>/</span><span>Fatalities since 1980</span>
          </nav>
          <span class="eyebrow">Conflict trends · 1980–2026</span>
          <h1>Deaths linked to LWE incidents since 1980.</h1>
          <p>
            Explore changes in civilian and security-force fatalities alongside
            the separately reported deaths of extremists over nearly five decades.
          </p>
        </div>

        <aside class="hero-note">
          <span>How to read the data</span>
          <strong>Two different totals</strong>
          <p>
            “Total deaths” combines civilians and security personnel. Extremist
            deaths are reported as a separate series and are not included in that total.
          </p>
        </aside>
      </div>
    </section>

    <section class="dashboard-section">
      <div class="shell">
        <div class="dashboard-head">
          <div>
            <span class="eyebrow">Interactive dataset</span>
            <h2>Change across the years</h2>
          </div>
          <p id="range-description" aria-live="polite">Showing the complete record from 1980 to 2026.</p>
        </div>

        <div class="range-controls" aria-label="Select reporting period">
          <label>
            <span>Start year</span>
            <select id="start-year">
              {records.map((row) => <option value={row[0]} selected={row[0] === 1980}>{row[0]}</option>)}
            </select>
          </label>
          <label>
            <span>End year</span>
            <select id="end-year">
              {records.map((row) => <option value={row[0]} selected={row[0] === 2026}>{row[0]}</option>)}
            </select>
          </label>
          <button type="button" id="reset-range">Reset period</button>
        </div>

        <div class="metric-grid" aria-live="polite">
          <article><span>Total deaths</span><strong id="sum-total">17,380</strong><small>Civilians + security forces</small></article>
          <article><span>Civilians killed</span><strong id="sum-civilians">13,772</strong><small id="civilian-share">79.2% of total deaths</small></article>
          <article><span>Security-force casualties</span><strong id="sum-forces">3,608</strong><small id="force-share">20.8% of total deaths</small></article>
          <article><span>Extremists died</span><strong id="sum-extremists">6,621</strong><small>Separate reported series</small></article>
        </div>

        <section class="chart-panel" aria-labelledby="chart-title">
          <div class="chart-heading">
            <div><span>Year-wise trend</span><h3 id="chart-title">Deaths reported per year</h3></div>
            <div class="series-controls" role="group" aria-label="Select chart series">
              <label><input type="checkbox" data-series="total" checked /><i class="swatch total"></i>Total deaths</label>
              <label><input type="checkbox" data-series="civilians" /><i class="swatch civilians"></i>Civilians</label>
              <label><input type="checkbox" data-series="forces" /><i class="swatch forces"></i>Security forces</label>
              <label><input type="checkbox" data-series="extremists" checked /><i class="swatch extremists"></i>Extremists</label>
            </div>
          </div>

          <div class="chart-wrap" id="chart-wrap">
            <svg id="trend-chart" viewBox="0 0 1100 480" role="img" aria-labelledby="chart-title chart-desc">
              <desc id="chart-desc">Interactive line chart showing annual deaths linked to Left Wing Extremism from 1980 to 2026.</desc>
            </svg>
            <div class="chart-tooltip" id="chart-tooltip" role="tooltip" hidden></div>
          </div>
        </section>

        <section class="decade-section" aria-labelledby="decade-title">
          <div class="section-heading">
            <div><span class="eyebrow">Period comparison</span><h2 id="decade-title">The record by decade</h2></div>
            <p>Select a period to apply it to the chart and table.</p>
          </div>

          <div class="decade-grid">
            {decades.map((decade) => (
              <button type="button" class="decade-card" data-start={decade.start} data-end={decade.end}>
                <span>{decade.label}</span>
                <strong>{decade.total.toLocaleString('en-IN')}</strong>
                <small>Total civilian + SF deaths</small>
                <div class="composition" aria-label={`${decade.civilians} civilians and ${decade.forces} security personnel`}>
                  <i style={`width:${(decade.civilians / decade.total) * 100}%`}></i><b></b>
                </div>
                <dl>
                  <div><dt>Civilians</dt><dd>{decade.civilians.toLocaleString('en-IN')}</dd></div>
                  <div><dt>Security forces</dt><dd>{decade.forces.toLocaleString('en-IN')}</dd></div>
                  <div><dt>Extremists</dt><dd>{decade.extremists.toLocaleString('en-IN')}</dd></div>
                </dl>
              </button>
            ))}
          </div>
        </section>

        <details class="data-table-section">
          <summary>
            <span><small>Complete dataset</small><strong>View year-wise table</strong></span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Year</th><th>Total deaths</th><th>Civilians killed</th><th>SF casualties</th><th>Extremists died</th></tr></thead>
              <tbody id="data-rows">
                {records.map((row) => (
                  <tr data-year={row[0]}><th>{row[0]}{row[0] === 2026 && <sup>*</sup>}</th><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td><td>{row[4]}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>

        <div class="source-note">
          <span>Source and limitations</span>
          <p>
            Figures transcribed from the supplied “Deaths due to LWE incidents”
            table. The original issuing authority and reporting cutoff should be
            added before publication. *The 2026 figure is treated as partial and
            provisional because the source image does not specify a cutoff date.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script type="application/json" id="fatality-records" set:html={JSON.stringify(records)}></script>

<script>
  const dataElement = document.querySelector('#fatality-records');
  const data = dataElement ? JSON.parse(dataElement.textContent || '[]') : [];
  const startSelect = document.querySelector('#start-year');
  const endSelect = document.querySelector('#end-year');
  const svg = document.querySelector('#trend-chart');
  const tooltip = document.querySelector('#chart-tooltip');
  const chartWrap = document.querySelector('#chart-wrap');

  const series = {
    total: { index:1, label:'Total deaths', className:'line-total' },
    civilians: { index:2, label:'Civilians', className:'line-civilians' },
    forces: { index:3, label:'Security forces', className:'line-forces' },
    extremists: { index:4, label:'Extremists', className:'line-extremists' },
  };

  const format = (value) => Number(value).toLocaleString('en-IN');
  const selectedSeries = () => Array.from(document.querySelectorAll('[data-series]:checked')).map((input) => input.getAttribute('data-series'));
  const selectedData = () => {
    const start = Number(startSelect?.value || 1980);
    const end = Number(endSelect?.value || 2026);
    return data.filter((row) => row[0] >= start && row[0] <= end);
  };

  function updateSummary(rows) {
    const sums = [1,2,3,4].map((index) => rows.reduce((sum,row) => sum + row[index], 0));
    const ids = ['sum-total','sum-civilians','sum-forces','sum-extremists'];
    ids.forEach((id,index) => { const node=document.querySelector(`#${id}`); if(node) node.textContent=format(sums[index]); });
    const civilianShare = document.querySelector('#civilian-share');
    const forceShare = document.querySelector('#force-share');
    if (civilianShare) civilianShare.textContent = sums[0] ? `${(sums[1]/sums[0]*100).toFixed(1)}% of total deaths` : 'No deaths in period';
    if (forceShare) forceShare.textContent = sums[0] ? `${(sums[2]/sums[0]*100).toFixed(1)}% of total deaths` : 'No deaths in period';
    const description = document.querySelector('#range-description');
    if (description && rows.length) description.textContent = `Showing ${rows[0][0]} to ${rows[rows.length-1][0]} · ${rows.length} reporting years.`;
    document.querySelectorAll('#data-rows tr').forEach((row) => {
      const year = Number(row.getAttribute('data-year'));
      row.toggleAttribute('hidden', !rows.some((item) => item[0] === year));
    });
  }

  function drawChart() {
    if (!(svg instanceof SVGElement)) return;
    const rows = selectedData();
    const active = selectedSeries();
    updateSummary(rows);
    svg.innerHTML = '<title>Annual deaths linked to LWE incidents</title><desc>Use the metric controls and hover over the chart for year-wise values.</desc>';
    if (!rows.length || !active.length) return;

    const W=1100,H=480,m={top:24,right:26,bottom:58,left:72};
    const plotW=W-m.left-m.right, plotH=H-m.top-m.bottom;
    const maxValue = Math.max(
  ...rows.flatMap((row) =>
    active.map((key) => row[series[key].index])
  )
);
    const yMax=Math.ceil(maxValue/100)*100 || 100;
    const x=(year)=>m.left+((year-rows[0][0])/Math.max(1,rows[rows.length-1][0]-rows[0][0]))*plotW;
    const y=(value)=>m.top+plotH-(value/yMax)*plotH;
    const ns='http://www.w3.org/2000/svg';
    const add=(name,attrs,parent=svg)=>{const el=document.createElementNS(ns,name);Object.entries(attrs).forEach(([k,v])=>el.setAttribute(k,String(v)));parent.appendChild(el);return el;};

    add('rect',{x:m.left,y:m.top,width:plotW,height:plotH,class:'plot-frame'});
    for(let i=0;i<=5;i++){
      const value=Math.round(yMax*i/5); const yy=y(value);
      add('line',{x1:m.left,x2:W-m.right,y1:yy,y2:yy,class:'grid-line'});
      const label=add('text',{x:m.left-13,y:yy+4,'text-anchor':'end',class:'axis-label'}); label.textContent=format(value);
    }
    const tickStep=rows.length>30?10:rows.length>15?5:2;
    rows.forEach((row,index)=>{if(index%tickStep===0||index===rows.length-1){const label=add('text',{x:x(row[0]),y:H-25,'text-anchor':'middle',class:'axis-label'});label.textContent=String(row[0]);}});
    const yTitle=add('text',{x:18,y:m.top+plotH/2,transform:`rotate(-90 18 ${m.top+plotH/2})`,'text-anchor':'middle',class:'axis-title'});yTitle.textContent='Deaths reported';
    const xTitle=add('text',{x:m.left+plotW/2,y:H-2,'text-anchor':'middle',class:'axis-title'});xTitle.textContent='Year';

    active.forEach((key)=>{
      const config=series[key];
      const d=rows.map((row,index)=>`${index===0?'M':'L'} ${x(row[0]).toFixed(2)} ${y(row[config.index]).toFixed(2)}`).join(' ');
      add('path',{d,class:`series-line ${config.className}`,'data-series-line':key});
    });

    const guide=add('line',{x1:m.left,x2:m.left,y1:m.top,y2:m.top+plotH,class:'hover-guide'});
    const markers={};
    active.forEach((key)=>{markers[key]=add('circle',{r:5,cx:m.left,cy:m.top,class:`hover-marker ${series[key].className}`});});
    const overlay=add('rect',{x:m.left,y:m.top,width:plotW,height:plotH,class:'hover-overlay'});

    const show=(event)=>{
      const rect=svg.getBoundingClientRect();
      const px=(event.clientX-rect.left)/rect.width*W;
      const rawYear=rows[0][0]+((px-m.left)/plotW)*(rows[rows.length-1][0]-rows[0][0]);
      const row=rows.reduce((best,current)=>Math.abs(current[0]-rawYear)<Math.abs(best[0]-rawYear)?current:best,rows[0]);
      const gx=x(row[0]); guide.setAttribute('x1',gx);guide.setAttribute('x2',gx);guide.classList.add('visible');
      active.forEach((key)=>{const marker=markers[key];marker.setAttribute('cx',gx);marker.setAttribute('cy',y(row[series[key].index]));marker.classList.add('visible');});
      if(tooltip instanceof HTMLElement && chartWrap instanceof HTMLElement){
        tooltip.innerHTML=`<strong>${row[0]}${row[0]===2026?'*':''}</strong>${active.map((key)=>`<span><i class="${series[key].className}"></i>${series[key].label}<b>${format(row[series[key].index])}</b></span>`).join('')}`;
        tooltip.hidden=false;
        const wrapRect=chartWrap.getBoundingClientRect();
        const left=(gx/W)*wrapRect.width;
        tooltip.style.left=`${Math.min(Math.max(left,90),wrapRect.width-90)}px`;
        tooltip.style.top=`${Math.max(10,(event.clientY-wrapRect.top)-90)}px`;
      }
    };
    const hide=()=>{guide.classList.remove('visible');Object.values(markers).forEach((marker)=>marker.classList.remove('visible'));if(tooltip instanceof HTMLElement)tooltip.hidden=true;};
    overlay.addEventListener('pointermove',show); overlay.addEventListener('pointerleave',hide); overlay.addEventListener('click',show);
  }

  function normaliseRange(changed) {
    if (!(startSelect instanceof HTMLSelectElement) || !(endSelect instanceof HTMLSelectElement)) return;
    if (Number(startSelect.value) > Number(endSelect.value)) {
      if (changed === 'start') endSelect.value = startSelect.value;
      else startSelect.value = endSelect.value;
    }
    drawChart();
  }

  startSelect?.addEventListener('change',()=>normaliseRange('start'));
  endSelect?.addEventListener('change',()=>normaliseRange('end'));
  document.querySelectorAll('[data-series]').forEach((input)=>input.addEventListener('change',drawChart));
  document.querySelector('#reset-range')?.addEventListener('click',()=>{if(startSelect instanceof HTMLSelectElement)startSelect.value='1980';if(endSelect instanceof HTMLSelectElement)endSelect.value='2026';drawChart();});
  document.querySelectorAll('.decade-card').forEach((button)=>button.addEventListener('click',()=>{if(startSelect instanceof HTMLSelectElement)startSelect.value=button.getAttribute('data-start')||'1980';if(endSelect instanceof HTMLSelectElement)endSelect.value=button.getAttribute('data-end')||'2026';drawChart();document.querySelector('.chart-panel')?.scrollIntoView({behavior:'smooth',block:'start'});}));
  drawChart();
</script>

<style>
  .fatalities-page{--ink:#111b20;--paper:#f3efe5;--light:#fffdf8;--line:#cec6b8;--rust:#a34f32;--forest:#234f46;--sage:#789b8e;--gold:#b88738;--dark:#172327;background:var(--paper);color:var(--ink)}.eyebrow{font:800 11px/1.2 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:var(--rust)}
  .fatalities-hero{padding:68px 0 64px;border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.55fr);gap:72px;align-items:end}.breadcrumbs{display:flex;gap:9px;margin-bottom:52px;font:700 12px/1.2 system-ui,sans-serif;color:#7b756c}.breadcrumbs a{color:inherit;text-decoration:none}.fatalities-hero h1{max-width:900px;margin:13px 0 24px;font:700 clamp(52px,7vw,90px)/.93 Georgia,serif;letter-spacing:-.05em}.fatalities-hero p{max-width:760px;margin:0;font:400 20px/1.55 Georgia,serif;color:#5f5d57}.hero-note{padding:24px;border-top:3px solid var(--rust);background:#e9e2d6}.hero-note>span{display:block;margin-bottom:27px;font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:var(--rust)}.hero-note strong{display:block;font:700 25px/1.05 Georgia,serif}.hero-note p{margin:13px 0 0;font:400 15px/1.55 Georgia,serif;color:#625f59}
  .dashboard-section{padding:76px 0 90px}.dashboard-head,.section-heading{display:grid;grid-template-columns:1fr minmax(280px,460px);gap:70px;align-items:end;margin-bottom:30px}.dashboard-head h2,.section-heading h2{margin:9px 0 0;font:700 clamp(40px,5vw,60px)/.98 Georgia,serif;letter-spacing:-.035em}.dashboard-head>p,.section-heading>p{margin:0;font:400 16px/1.6 Georgia,serif;color:#625f59}.range-controls{display:flex;align-items:end;gap:12px;margin-bottom:26px}.range-controls label{display:grid;gap:7px}.range-controls label span{font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#706a61}.range-controls select,.range-controls button{height:42px;padding:0 13px;border:1px solid var(--line);background:var(--light);color:var(--ink);font:700 13px/1 system-ui,sans-serif}.range-controls button{cursor:pointer}.range-controls button:hover{background:var(--dark);color:#fffdf8}
  .metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:46px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.metric-grid article{min-height:155px;padding:20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--light)}.metric-grid span,.metric-grid small{display:block;font:750 10px/1.3 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#756f66}.metric-grid strong{display:block;margin:20px 0 10px;font:700 38px/1 Georgia,serif;color:var(--rust)}.metric-grid small{text-transform:none;letter-spacing:0}
  .chart-panel{scroll-margin-top:40px;padding:28px;border:1px solid var(--line);background:var(--light)}.chart-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:30px;margin-bottom:24px}.chart-heading>div>span{font:800 10px/1 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.1em;color:var(--rust)}.chart-heading h3{margin:8px 0 0;font:700 29px/1.05 Georgia,serif}.series-controls{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px 18px}.series-controls label{display:flex;align-items:center;gap:7px;font:700 11px/1 system-ui,sans-serif;cursor:pointer}.series-controls input{width:15px;height:15px;accent-color:var(--dark)}.swatch{width:16px;height:3px}.swatch.total{background:var(--rust)}.swatch.civilians{background:var(--gold)}.swatch.forces{background:var(--forest)}.swatch.extremists{background:var(--sage)}.chart-wrap{position:relative;min-width:0}.chart-wrap svg{display:block;width:100%;height:auto;min-height:310px;overflow:visible}.chart-wrap :global(.plot-frame){fill:#faf8f3;stroke:#d8d0c3}.chart-wrap :global(.grid-line){stroke:#e2dbd0;stroke-width:1}.chart-wrap :global(.axis-label),.chart-wrap :global(.axis-title){fill:#6e685f;font:600 12px system-ui,sans-serif}.chart-wrap :global(.series-line){fill:none;stroke-width:3;stroke-linejoin:round;stroke-linecap:round}.chart-wrap :global(.line-total){stroke:var(--rust);color:var(--rust)}.chart-wrap :global(.line-civilians){stroke:var(--gold);color:var(--gold)}.chart-wrap :global(.line-forces){stroke:var(--forest);color:var(--forest)}.chart-wrap :global(.line-extremists){stroke:var(--sage);color:var(--sage)}.chart-wrap :global(.hover-guide){stroke:#777168;stroke-width:1;opacity:0}.chart-wrap :global(.hover-guide.visible){opacity:1}.chart-wrap :global(.hover-marker){fill:#fffdf8;stroke-width:3;opacity:0}.chart-wrap :global(.hover-marker.visible){opacity:1}.chart-wrap :global(.hover-overlay){fill:transparent;cursor:crosshair}.chart-tooltip{position:absolute;z-index:4;transform: