t:700 54px/1 Georgia,serif;display:block}.mini-stat span{display:block;margin-top:7px;font:600 11px/1.4 system-ui,sans-serif;color:#716b62;max-width:190px}.records-section{padding-top:4px}.records-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:16px}.download{display:inline-flex;padding:10px 14px;border:1px solid #bcb3a6;color:#111b20;text-decoration:none;font:700 11px system-ui,sans-serif;background:#fffdf8}.filters{display:grid;grid-template-columns:1.7fr .8fr 1fr 1.15fr auto;gap:10px;align-items:end;background:#fffdf8;border:1px solid #d9d1c3;padding:14px;margin-bottom:10px}.filters label{display:grid;gap:5px;font:700 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.07em;color:#756e65}.filters input,.filters select{width:100%;min-height:42px;border:1px solid #c9c0b3;background:white;padding:0 12px;font:500 13px system-ui,sans-serif;color:#172127}.filters button{min-height:42px;border:1px solid #afa598;background:#f2ede4;padding:0 16px;font-weight:700;cursor:pointer}.result-row{display:flex;gap:5px;align-items:baseline;font:500 12px system-ui,sans-serif;color:#706a62;margin:9px 0}.result-row strong{font-size:15px;color:#111b20}.table-wrap{overflow-x:auto;background:#fffdf8;border:1px solid #d9d1c3}.infra-table{width:100%;border-collapse:collapse;min-width:760px}.infra-table th{background:#e9e2d6;text-align:left;font:700 11px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.055em;color:#514c46;padding:12px 13px;border-bottom:1px solid #d3cabe}.infra-table td{padding:12px 13px;border-bottom:1px solid #e5ded3;font:500 13px/1.35 system-ui,sans-serif;color:#283239}.infra-table tbody tr:hover{background:#faf6ee}.count{font:800 16px Georgia,serif}.infra-table tr[hidden]{display:none}
  @media(max-width:850px){.dashboard{grid-template-columns:1fr}.filters{grid-template-columns:1fr 1fr}.filters .search{grid-column:1/-1}.filters button{width:100%}.records-head{align-items:flex-start;flex-direction:column}}
  @media(max-width:560px){.intro h1{font-size:44px}.trend-card,.analysis-card{padding:17px}.trend-chart{gap:7px}.trend-bar-wrap i{width:60%}.filters{grid-template-columns:1fr}.filters .search{grid-column:auto}}
</style>
