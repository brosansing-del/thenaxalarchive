---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import Papa from 'papaparse';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const csvPath = path.join(process.cwd(), 'public', 'data', 'infrastructure-targeting.csv');
const csvText = fs.readFileSync(csvPath, 'utf8');
const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true, dynamicTyping: true });
const records = parsed.data;

const years = [...new Set(records.map((r) => String(r.year)))].sort();
const states = [...new Set(records.map((r) => r.state))].sort();
const types = [...new Set(records.map((r) => r.infrastructure_type))].sort();
const annual = years.map((year) => ({
  year,
  total: records.filter((r) => String(r.year) === year).reduce((s, r) => s + Number(r.count || 0), 0),
}));
const maxAnnual = Math.max(...annual.map((d) => d.total));
const totalAll = records.reduce((s, r) => s + Number(r.count || 0), 0);

---
<BaseLayout title="Infrastructure Targeting by LWE Outfits — The Naxal Archive" description="Interactive source-derived record of infrastructure targeted by LWE outfits, 2021–2025.">
  <Header />
  <main class="infra-page">
    <section class="shell intro">
      <div class="crumbs"><a href={`${BASE}/`}>Home</a><span>›</span><a href={`${BASE}/data-visuals/`}>Data & Visuals</a><span>›</span><strong>Infrastructure targeting</strong></div>
      <span class="eyebrow">Data & Visuals · Infrastructure</span>
      <h1>Infrastructure Targeting by LWE Outfits</h1>
    </section>

    <section class="shell dashboard">
      <div class="trend-card">
        <div class="card-head">
          <div><span class="eyebrow">Trend</span><h2>Recorded incidents by year</h2></div>
         
        </div>
        <div class="trend-chart" aria-label="Annual infrastructure targeting incidents">
          {annual.map((d) => (
            <button class="trend-year" type="button" data-year={d.year} aria-label={`${d.year}: ${d.total} incidents`}>
              <span class="trend-value">{d.total}</span>
              <span class="trend-bar-wrap"><i style={`height:${Math.max(8,(d.total/maxAnnual)*170)}px`}></i></span>
              <small>{d.year}</small>
            </button>
          ))}
        </div>
      </div>

      <div class="analysis-card">
        <span class="eyebrow">Explore</span>
        <h2>Filter the record</h2>
        <p>Select a year, state or infrastructure type. The table and summary update instantly.</p>
        <div class="mini-stat"><strong id="visibleTotal">{totalAll}</strong><span>recorded incidents in current view</span></div>
      </div>
    </section>

    <section class="shell records-section">
      <div class="records-head">
        <div><span class="eyebrow">Infrastructure record</span><h2>Search or filter the source-derived data below.</h2></div>
        <a class="download" href={`${BASE}/data/infrastructure-targeting.csv`} download>Download CSV ↓</a>
      </div>

      <div class="filters">
        <label class="search"><span>Search</span><input id="infraSearch" type="search" placeholder="State or infrastructure type…" /></label>
        <label><span>Year</span><select id="yearFilter"><option value="">All years</option>{years.map((y) => <option value={y}>{y}</option>)}</select></label>
        <label><span>State</span><select id="stateFilter"><option value="">All states</option>{states.map((s) => <option value={s}>{s}</option>)}</select></label>
        <label><span>Type</span><select id="typeFilter"><option value="">All types</option>{types.map((t) => <option value={t}>{t}</option>)}</select></label>
        <button id="resetFilters" type="button">Reset</button>
      </div>

      <div class="result-row"><strong id="rowCount">{records.length}</strong><span>rows shown</span></div>

      <div class="table-wrap">
        <table class="infra-table">
          <thead><tr><th>Year</th><th>State</th><th>Infrastructure type</th><th>Incidents</th></tr></thead>
          <tbody id="infraRows">
            {records.map((r) => (
              <tr data-year={String(r.year)} data-state={r.state} data-type={r.infrastructure_type} data-search={`${r.state} ${r.infrastructure_type}`.toLowerCase()} data-count={String(r.count)}>
                <td>{r.year}</td><td><strong>{r.state}</strong></td><td>{r.infrastructure_type}</td><td class="count">{r.count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const search = document.querySelector('#infraSearch');
  const year = document.querySelector('#yearFilter');
  const state = document.querySelector('#stateFilter');
  const type = document.querySelector('#typeFilter');
  const reset = document.querySelector('#resetFilters');
  const rowCount = document.querySelector('#rowCount');
  const visibleTotal = document.querySelector('#visibleTotal');
  const rows = [...document.querySelectorAll('#infraRows tr')];
  const yearButtons = [...document.querySelectorAll('.trend-year')];

  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    let total = 0;
    rows.forEach((row) => {
      const ok = (!q || row.dataset.search.includes(q)) &&
        (!year.value || row.dataset.year === year.value) &&
        (!state.value || row.dataset.state === state.value) &&
        (!type.value || row.dataset.type === type.value);
      row.hidden = !ok;
      if (ok) { visible += 1; total += Number(row.dataset.count || 0); }
    });
    rowCount.textContent = String(visible);
    visibleTotal.textContent = String(total);
    yearButtons.forEach((b) => b.classList.toggle('active', !!year.value && b.dataset.year === year.value));
  }

  [search, year, state, type].forEach((el) => el.addEventListener('input', applyFilters));
  yearButtons.forEach((btn) => btn.addEventListener('click', () => {
    year.value = year.value === btn.dataset.year ? '' : btn.dataset.year;
    applyFilters();
    document.querySelector('.records-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  reset.addEventListener('click', () => {
    search.value = ''; year.value = ''; state.value = ''; type.value = ''; applyFilters();
  });
</script>

<style>
