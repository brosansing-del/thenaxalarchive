---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import Papa from 'papaparse';

const BASE = import.meta.env.BASE_URL.replace(/\/+$/, '');
const csvPath = path.join(process.cwd(), 'public', 'data', 'sf-camps.csv');
const csvText = fs.readFileSync(csvPath, 'utf8');
const parsed = Papa.parse(csvText, { header: true, skipEmptyLines: true, dynamicTyping: true });
const rows = parsed.data;

const stateColumns = [
  'Andhra Pradesh','Bihar','Chhattisgarh','Jharkhand',
  'Madhya Pradesh','Maharashtra','Odisha','Telangana'
];

const overall = rows.reduce((sum, r) => sum + Number(r.total || 0), 0);
const peak = rows.reduce((a,b) => Number(a.total) > Number(b.total) ? a : b);
const maxAnnual = Math.max(...rows.map(r => Number(r.total || 0)));

const stateTotals = stateColumns.map((state) => ({
  state,
  total: rows.reduce((sum, r) => sum + Number(r[state] || 0), 0),
})).sort((a,b) => b.total - a.total);

const maxState = Math.max(...stateTotals.map(d => d.total));
---

<BaseLayout
  title="Security Force Camps Established Since 2013 — The Naxal Archive"
  description="Interactive year-wise and state-wise record of Security Force camps opened since 2013."
>
  <Header />

  <main class="sf-page">
    <section class="shell sf-intro">
      <div class="crumbs">
        <a href={`${BASE}/`}>Home</a><span>›</span>
        <a href={`${BASE}/data-visuals/`}>Data & Visuals</a><span>›</span>
        <strong>Security Force camps</strong>
      </div>

      <span class="eyebrow">Data & Visuals · Security footprint</span>
      <h1>Security Force Camps Established Since 2013</h1>
    </section>

    <section class="shell explorer">
      <div class="section-head">
        <div>
          <span class="eyebrow">Annual expansion</span>
          <h2>SF camps opened by year</h2>
        </div>
        <a class="download" href={`${BASE}/data/sf-camps.csv`} download>Download CSV ↓</a>
      </div>

      <div class="trend-card">
        <div class="trend-bars">
          {rows.map((r) => (
            <button
              class:list={["trend-year", r.year === 2025 && "peak-year", r.year === 2026 && "partial-year"]}
              type="button"
              data-year={String(r.year)}
              aria-label={`${r.year}: ${r.total} camps opened`}
              title={`${r.year}: ${r.total}${r.year === 2026 ? ' (till 20 Mar)' : ''}`}
            >
              <span class="bar-area">
                <i style={`height:${Math.max(5,(Number(r.total)/maxAnnual)*210)}px`}></i>
              </span>
              <strong>{r.total}</strong>
              <small>{r.year === 2026 ? '2026*' : r.year}</small>
            </button>
          ))}
        </div>
        <p class="partial-note">* 2026 is a partial-year figure: till 20 March 2026.</p>
      </div>

      <div class="filter-row">
        <label>
          <span>Year</span>
          <select id="yearFilter">
            <option value="">All years</option>
            {rows.map(r => <option value={String(r.year)}>{r.year}{r.year === 2026 ? ' (till 20 Mar)' : ''}</option>)}
          </select>
        </label>

        <label>
          <span>State</span>
          <select id="stateFilter">
            <option value="">All states</option>
            {stateColumns.map(s => <option value={s}>{s}</option>)}
          </select>
        </label>

        <button id="resetFilters" type="button">Reset</button>
      </div>

      <div class="focus-grid">
        <article class="focus-card primary">
          <span class="eyebrow">Selected view</span>
          <strong id="focusValue">{overall.toLocaleString('en-IN')}</strong>
          <p id="focusLabel">Total camps opened across all listed years and states</p>
        </article>

        <article class="focus-card secondary">
          <span class="eyebrow">Highest annual addition</span>
          <strong>{peak.total}</strong>
          <p>{peak.year}</p>
        </article>
      </div>

      <div class="visual-grid">
        <article class="panel">
          <div class="panel-head">
            <span class="eyebrow">State distribution</span>
            <h2 id="stateTitle">Camps opened · all years</h2>
          </div>

          <div class="state-bars" id="stateBars">
            {stateTotals.map(d => (
              <button class="state-row" type="button" data-state={d.state}>
                <span class="state-name">{d.state}</span>
                <span class="track"><i style={`width:${(d.total/maxState)*100}%`}></i></span>
                <strong>{d.total}</strong>
              </button>
            ))}
          </div>
        </article>

        <article class="panel table-panel">
          <div class="panel-head">
            <span class="eyebrow">Record</span>
            <h2>Year-wise totals</h2>
          </div>

          <div class="mini-table-wrap">
            <table class="mini-table">
              <thead><tr><th>Year</th><th>Total</th><th>Period</th></tr></thead>
              <tbody>
                {rows.map(r => (
                  <tr data-year={String(r.year)}>
                    <td>{r.year}</td>
                    <td><strong>{r.total}</strong></td>
                    <td>{r.period}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ rows, stateColumns }}>
  const yearFilter = document.querySelector('#yearFilter');
  const stateFilter = document.querySelector('#stateFilter');
  const reset = document.querySelector('#resetFilters');
  const focusValue = document.querySelector('#focusValue');
  const focusLabel = document.querySelector('#focusLabel');
  const stateBars = document.querySelector('#stateBars');
  const stateTitle = document.querySelector('#stateTitle');
  const yearButtons = [...document.querySelectorAll('.trend-year')];

  function fmt(n) { return Number(n || 0).toLocaleString('en-IN'); }

  function stateData(selectedYear = '') {
    const dataset = selectedYear ? rows.filter(r => String(r.year) === String(selectedYear)) : rows;
    return stateColumns.map(state => ({
      state,
      total: dataset.reduce((sum, r) => sum + Number(r[state] || 0), 0),
    })).sort((a,b) => b.total - a.total);
  }

  function renderStateBars(selectedYear = '') {
    const values = stateData(selectedYear);
    const max = Math.max(...values.map(v => v.total), 1);

    stateBars.innerHTML = values
      .filter(v => v.total > 0)
      .map(v => `
        <button class="state-row" type="button" data-state="${v.state}">
          <span class="state-name">${v.state}</span>
          <span class="track"><i style="width:${(v.total/max)*100}%"></i></span>
          <strong>${fmt(v.total)}</strong>
        </button>
      `).join('');

    stateTitle.textContent = selectedYear ? `Camps opened · ${selectedYear}` : 'Camps opened · all years';

    stateBars.querySelectorAll('.state-row').forEach(btn => {
      btn.addEventListener('click', () => {
        stateFilter.value = btn.dataset.state;
        update();
      });
    });
  }

  function update() {
    const year = yearFilter.value;
    const state = stateFilter.value;
    let value = 0;

    if (year && state) {
      const row = rows.find(r => String(r.year) === year);
      value = row ? Number(row[state] || 0) : 0;
      focusLabel.textContent = `${state} · ${year}`;
    } else if (year) {
      const row = rows.find(r => String(r.year) === year);
      value = row ? Number(row.total || 0) : 0;
      focusLabel.textContent = `All listed states · ${year}${year === '2026' ? ' (till 20 March)' : ''}`;
    } else if (state) {
      value = rows.reduce((sum, r) => sum + Number(r[state] || 0), 0);
      focusLabel.textContent = `${state} · all years`;
    } else {
      value = rows.reduce((sum, r) => sum + Number(r.total || 0), 0);
      focusLabel.textContent = 'Total camps opened across all listed years and states';
    }

    focusValue.textContent = fmt(value);
    renderStateBars(year);

    yearButtons.forEach(btn => {
      btn.classList.toggle('selected', !!year && btn.dataset.year === year);
      btn.classList.toggle('muted', !!year && btn.dataset.year !== year);
    });
  }

  yearFilter.addEventListener('change', update);
  stateFilter.addEventListener('change', update);

  yearButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      yearFilter.value = yearFilter.value === btn.dataset.year ? '' : btn.dataset.year;
      update();
    });
  });

  reset.addEventListener('click', () => {
    yearFilter.value = '';
    stateFilter.value = '';
    update();
  });

  renderStateBars('');
</script>

<style>
  .sf-page{background:#f2efe7;color:#122126;padding-bottom:78px}
  .sf-page .shell{max-width:1180px}
  .sf-intro{padding-top:34px;padding-bottom:24px}
  .crumbs{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:28px;font:700 10px/1.4 system-ui,sans-serif;text-transform:uppercase;letter-spacing:.08em;color:#767064}
  .crumbs a{color:inherit;text-decoration:none}
  .eyebrow{font:800 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.12em;color:#a84d35}
  .sf-intro h1{max-width:930px;margin:8px 0 0;font:700 clamp(44px,6vw,76px)/.98 Georgia,serif;letter-spacing:-.038em}
  .explorer{padding-top:18px}
  .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:15px}
  .section-head h2,.panel h2{margin:5px 0 0;font:700 28px/1.08 Georgia,serif}
  .download{display:inline-flex;align-items:center;min-height:42px;padding:0 14px;border:1px solid #b9b0a1;background:#fffdf8;color:#122126;text-decoration:none;font:750 11px system-ui,sans-serif}
  .trend-card{background:#fffdf8;border:1px solid #d9d1c3;padding:22px 20px 14px}
  .trend-bars{height:300px;display:flex;gap:8px;align-items:flex-end;overflow-x:auto;-webkit-overflow-scrolling:touch;padding:0 2px 8px}
  .trend-year{appearance:none;border:0;background:transparent;min-width:54px;height:275px;padding:0;display:grid;grid-template-rows:1fr auto auto;align-items:end;gap:5px;cursor:pointer;color:#363a38;transition:opacity .2s ease}
  .bar-area{height:220px;display:flex;align-items:flex-end;justify-content:center}
  .bar-area i{width:30px;min-height:4px;display:block;border-radius:3px 3px 0 0;background:linear-gradient(180deg,#527569,#789489);transition:height .25s ease,background .2s ease}
  .trend-year strong{font:750 10px system-ui,sans-serif}
  .trend-year small{font:750 9px system-ui,sans-serif}
  .trend-year.peak-year .bar-area i{background:linear-gradient(180deg,#a84d35,#c37b5f)}
  .trend-year.partial-year .bar-area i{background:linear-gradient(180deg,#4d6072,#758699)}
  .trend-year.selected .bar-area i{background:#15282e}
  .trend-year.muted{opacity:.25}
  .partial-note{margin:7px 0 0;font:600 11px system-ui,sans-serif;color:#716a60}
  .filter-row{display:grid;grid-template-columns:1fr 1fr auto;gap:10px;padding:14px;border:1px solid #d9d1c3;border-top:0;background:#fffdf8}
  .filter-row label{display:grid;gap:5px;font:800 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.07em;color:#756e65}
  .filter-row select{min-height:44px;border:1px solid #c9c0b3;background:#fff;padding:0 12px;font:600 13px system-ui,sans-serif;color:#172127}
  .filter-row button{min-height:44px;align-self:end;border:1px solid #afa598;background:#e8e2d7;padding:0 18px;font-weight:750;cursor:pointer}
  .focus-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:14px;margin:18px 0}
  .focus-card{min-height:160px;padding:24px;border:1px solid #d5ccbe}
  .focus-card.primary{background:#18322f;color:#fffdf8;border-color:#18322f}
  .focus-card.primary .eyebrow{color:#d9ad90}
  .focus-card.secondary{background:#dfe7e2}
  .focus-card>strong{display:block;margin:9px 0 8px;font:700 56px/1 Georgia,serif}
  .focus-card p{margin:0;font:550 13px/1.5 system-ui,sans-serif}
  .focus-card.primary p{color:#d9e1de}
  .visual-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:14px}
  .panel{background:#fffdf8;border:1px solid #d9d1c3;padding:21px}
  .panel-head{margin-bottom:18px}
  .state-bars{display:grid;gap:10px}
  .state-row{width:100%;appearance:none;border:0;background:transparent;padding:4px 0;display:grid;grid-template-columns:145px 1fr 56px;gap:10px;align-items:center;text-align:left;color:#172127;cursor:pointer;font:650 12px system-ui,sans-serif}
  .track{height:13px;background:#e8e5dd;overflow:hidden;border-radius:2px}
  .track i{display:block;height:100%;background:linear-gradient(90deg,#527569,#90a69e)}
  .state-row strong{text-align:right}
  .mini-table-wrap{max-height:470px;overflow:auto;border:1px solid #e2dbd0}
  .mini-table{width:100%;border-collapse:collapse}
  .mini-table th{position:sticky;top:0;background:#e5ece8;padding:10px;text-align:left;font:800 10px system-ui,sans-serif;text-transform:uppercase;letter-spacing:.06em}
  .mini-table td{padding:9px 10px;border-top:1px solid #e9e2d8;font:600 12px system-ui,sans-serif}
  @media(max-width:900px){.focus-grid,.visual-grid{grid-template-columns:1fr}}
  @media(max-width:600px){
    .sf-intro{padding-top:26px}
    .sf-intro h1{font-size:43px}
    .section-head{align-items:flex-start;flex-direction:column}
    .filter-row{grid-template-columns:1fr}
    .filter-row select,.filter-row button{font-size:16px}
    .trend-card{padding-left:10px;padding-right:10px}
    .state-row{grid-template-columns:110px 1fr 44px}
    .focus-card>strong{font-size:48px}
  }
</style>
